#!/bin/sh
# SPDX-FileCopyrightText: 2026 llmpalooza contributors
# SPDX-License-Identifier: Apache-2.0
#
# The llmp package's postinst (D-063, D-074): the service user, the data
# directory, then the unit, which is enabled and started on first install
# and restarted on upgrade, as debhelper's snippets do.
set -e

case "$1" in
  configure|abort-upgrade|abort-deconfigure|abort-remove)
    systemd-sysusers ${DPKG_ROOT:+--root="$DPKG_ROOT"} llmp.conf
    systemd-tmpfiles ${DPKG_ROOT:+--root="$DPKG_ROOT"} --create llmp.conf || true
    if [ -z "$DPKG_ROOT" ]; then
      if deb-systemd-helper debian-installed llmp.service; then
        if deb-systemd-helper --quiet was-enabled llmp.service; then
          deb-systemd-helper enable llmp.service >/dev/null || true
        else
          deb-systemd-helper update-state llmp.service >/dev/null || true
        fi
      else
        deb-systemd-helper enable llmp.service >/dev/null || true
      fi
      if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        if [ -n "$2" ]; then
          deb-systemd-invoke restart llmp.service >/dev/null || true
        else
          deb-systemd-invoke start llmp.service >/dev/null || true
        fi
      fi
    fi
    ;;
esac
exit 0
