#!/bin/sh
# SPDX-FileCopyrightText: 2026 llmpalooza contributors
# SPDX-License-Identifier: Apache-2.0
#
# The llmp package's postrm. Removing or purging the package keeps
# /var/lib/llmp, /etc/llmp and the llmp user: installed models,
# records and configuration are the owner's to delete. Purging removes the
# conversations kept across a restart (D-105) in the default spill
# directory: their tokens and state are no one's to keep once the package
# is purged (D-014). A spill directory configured elsewhere is the
# owner's to empty.
set -e

if [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = purge ] && [ -z "$DPKG_ROOT" ]; then
  # The runtime's user owns /var/lib/llmp. Refuse existing links and
  # delete as that user: swapping a parent for a link after these checks
  # must never turn package purge into a root deletion elsewhere.
  if [ ! -L /var/lib/llmp/spill ] && [ -d /var/lib/llmp/spill/conversations ] &&
    [ ! -L /var/lib/llmp/spill/conversations ]; then
    /usr/sbin/runuser -u llmp -- rm -rf --one-file-system /var/lib/llmp/spill/conversations
  fi
  if [ -x /usr/bin/deb-systemd-helper ]; then
    deb-systemd-helper purge llmp.service >/dev/null || true
    deb-systemd-helper unmask llmp.service >/dev/null || true
  fi
fi
exit 0
