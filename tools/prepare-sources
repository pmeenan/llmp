"""Fetches, verifies and unpacks the locked third-party sources (D-017, D-057).

    tools/prepare-sources [--modules M[,M...]] [--dry-run]
    tools/prepare-sources --check

Reads third_party/sources.lock.json, validates it, and selects the closure
of the requested profile before acquiring anything: the core components
plus those of the named optional modules (default none, the
copyleft-disabled core profile). Each selected archive is downloaded into the
persistent cache (by SHA-256, re-verified on every use), checked and
unpacked by one parser, Python's tarfile (D-078), keeping only the lock's
`archive.keep` paths when it names any, patched as recorded, and checked
against the lock's tree digest before it appears in build/sources/.
Existing prepared trees are checked, not rebuilt; a modified one is an error.
`--check` only validates the lock. Configure and build never fetch; they
consume what this prepared (cmake/LlmpSources.cmake).
"""

import sys

sys.dont_write_bytecode = True

import argparse
import contextlib
import fcntl
import os
import pathlib
import shutil
import signal

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import llmp_sdk as sdklib  # noqa: E402
import llmp_sources as srclib  # noqa: E402
from llmp_sdk import SdkError  # noqa: E402
from llmp_sources import SourceError  # noqa: E402

STOP_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)


def log(message: str) -> None:
    print(message, flush=True)


def default_cache() -> pathlib.Path:
    return sdklib.resolve_root(sdklib.load().manifest["sdk"]["cache"])


def check_prepared(path: pathlib.Path, cid: str, comp: dict) -> bool:
    """True when path holds cid's prepared tree; False when absent. A mismatch is an error."""
    if not path.exists() and not path.is_symlink():
        return False
    if path.is_symlink() or not path.is_dir():
        raise SourceError(f"{path} is not a prepared directory; remove it and run this again")
    digest = srclib.tree_digest(path)
    if digest != comp["tree_sha256"]:
        raise SourceError(f"the prepared {cid} source at {path} was modified (tree {digest}, locked "
                          f"{comp['tree_sha256']}); remove it and run this again. For deliberate local edits, "
                          "build a copy with LLMP_SOURCE_OVERRIDE_<ID> instead (D-057)")
    return True


def prepare(cid: str, comp: dict, lock_dir: pathlib.Path, dest: pathlib.Path, cache: pathlib.Path) -> None:
    """Unpacks, patches and checks one component in a staging directory, then publishes it."""
    archive = srclib.fetch(cache, cid, comp["archive"], log)
    staging = dest / f".staging-{cid}-{os.getpid()}"
    shutil.rmtree(staging, ignore_errors=True)
    staging.mkdir(parents=True)
    try:
        tree = staging / "src"
        srclib.unpack_archive(archive, tree, comp["archive"].get("keep"))
        for patch in comp["patches"]:
            data = (lock_dir / patch["path"]).read_bytes()
            if srclib.hashlib.sha256(data).hexdigest() != patch["sha256"]:
                raise SourceError(f"{cid}: patch {patch['path']} does not match its recorded sha256")
            try:
                srclib.apply_patch(tree, data.decode("utf-8"))
            except (SourceError, UnicodeError) as e:
                raise SourceError(f"{cid}: patch {patch['path']}: {e}") from None
            log(f"  applied {patch['path']}")
        digest = srclib.tree_digest(tree)
        if digest != comp["tree_sha256"]:
            raise SourceError(f"the prepared {cid} tree is {digest}, but the lock records {comp['tree_sha256']}. "
                              "If you are updating the lock, review this tree and record its digest")
        tree.rename(srclib.prepared_dir(dest, cid, comp))
    finally:
        shutil.rmtree(staging, ignore_errors=True)


@contextlib.contextmanager
def dest_lock(dest: pathlib.Path):
    dest.mkdir(parents=True, exist_ok=True)
    with open(dest / ".prepare.lock", "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--modules", default="", help="comma-separated optional modules to prepare as well")
    parser.add_argument("--check", action="store_true", help="validate the lock and exit")
    parser.add_argument("--dry-run", action="store_true", help="print the plan and change nothing")
    parser.add_argument("--lock", type=pathlib.Path, default=srclib.LOCK, help=argparse.SUPPRESS)
    parser.add_argument("--dest", type=pathlib.Path, default=srclib.SOURCES_DIR, help=argparse.SUPPRESS)
    parser.add_argument("--cache", type=pathlib.Path, help=argparse.SUPPRESS)
    args = parser.parse_args()
    for name in ("lock", "dest", "cache"):
        value = getattr(args, name)
        if value is not None and not value.is_absolute():
            setattr(args, name, value.resolve())

    modules = [m for m in args.modules.split(",") if m]
    lock = srclib.load_lock(args.lock, modules=None if args.check else modules)
    if args.check:
        log(f"{args.lock}: valid, {len(lock['components'])} component(s), "
            f"{len(lock.get('modules', {}))} optional module(s)")
        return 0
    selected = srclib.select(lock, modules)
    components = lock["components"]
    pending = [cid for cid in selected
               if not check_prepared(srclib.prepared_dir(args.dest, cid, components[cid]), cid, components[cid])]
    log(f"{srclib.license_profile(modules)} profile: {', '.join(selected) or 'no components'}")
    for cid in selected:
        state = "prepare" if cid in pending else "ready"
        log(f"  {cid:<16} {components[cid]['version']:<10} {state:<8} "
            f"{srclib.prepared_dir(args.dest, cid, components[cid])}")
    if args.dry_run or not pending:
        return 0

    cache = args.cache or default_cache()
    with dest_lock(args.dest):
        for stale in args.dest.glob(".staging-*"):  # left by an interrupted run
            shutil.rmtree(stale, ignore_errors=True)
        for cid in pending:
            comp = components[cid]
            if check_prepared(srclib.prepared_dir(args.dest, cid, comp), cid, comp):
                continue  # another run prepared it meanwhile
            log(f"preparing {cid} {comp['version']}")
            prepare(cid, comp, args.lock.parent, args.dest, cache)
    log(f"sources ready in {args.dest}")
    return 0


def _stop(signum, frame):
    # Unwinding removes the staging tree before releasing the preparation
    # lock. Ignore repeated signals so cleanup can finish.
    for s in STOP_SIGNALS:
        signal.signal(s, signal.SIG_IGN)
    if signum == signal.SIGINT:
        raise KeyboardInterrupt
    raise SystemExit(128 + signum)


if __name__ == "__main__":
    for s in STOP_SIGNALS:
        signal.signal(s, _stop)
    try:
        sys.exit(main())
    except (SourceError, SdkError) as e:
        print(f"prepare-sources: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
