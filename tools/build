#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 llmpalooza contributors
# SPDX-License-Identifier: Apache-2.0
"""Configures, builds, tests and deploys llmpalooza with the pinned SDK (D-011, D-012, D-061).

    tools/build build [PRESET...] [--fresh] [--locked]
    tools/build test [PRESET...] [--host HOST | --gpu] [--fresh] [--locked] [-- CTEST_ARGS...]
    tools/build deploy --host HOST [PRESET] [--fresh] [--locked]
    tools/build package [--fresh]

`mise run build`, `mise run test` and `mise run deploy` run these. PRESET
names a configure preset in CMakePresets.json; the default is this host's
native one (`native` on x86-64, `spark-native` on a Spark). Each runs the
SDK's CMake with LLMP_SDK set to the SDK this checkout's inputs describe,
into build/<PRESET>.

`test` builds, then runs CTest with the preset's test preset: GPU tests are
skipped except on a Spark, and cross-built tests run under qemu-user. With
--host, a cross build (`cross`, `cross-asan` or `cross-tsan`) is deployed to
HOST and its tests, GPU tests included, run there over SSH; `cross-tsan`
runs only that way. With --gpu, a native build (`native`) runs only its
`gpu-discrete` tests, one at a time, on this host's discrete GPU with its
driver (test preset `native-gpu`, D-082); nothing runs them by default, and
on a shared host they belong under its lock for GPU work. `deploy` copies a
cross build's executables and test files to HOST under
~/.cache/llmp/deploy/. Remote hosts are never implied
(D-012): name one.

`package` builds the `cross` preset --locked and makes the arm64 Debian
package from it (D-063, D-074): tools/llmp_package.py writes its copyright
file, third-party notices, SBOM and control facts into build/cross/package/doc,
then CPack writes build/cross/package/llmp_<version>_arm64.deb.

--locked configures as the check gate and release builds do (D-057, D-061):
the core profile, with no optional module, and no source override. Without
it, a source override set in the build directory's cache is honored.
"""

import sys

sys.dont_write_bytecode = True

import argparse
import hashlib
import json
import os
import pathlib
import shlex
import shutil
import subprocess

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import llmp_package as packagelib  # noqa: E402
import llmp_sdk as sdklib  # noqa: E402
from llmp_sdk import SdkError  # noqa: E402

PRESETS_FILE = sdklib.REPO / "CMakePresets.json"
DEFAULT_PRESET = {"x86_64": "native", "aarch64": "spark-native"}
# Presets whose tests can run on a remote host, and the test preset that
# does so (CMakePresets.json).
REMOTE_TEST_PRESET = {"cross": "cross-remote", "cross-asan": "cross-asan-remote",
                      "cross-tsan": "cross-tsan-remote"}
# Build-tree files a remote run never needs.
DEPLOY_EXCLUDES = ("CMakeFiles/", "*.o", "*.a", "/.ninja_*", "/build.ninja", "/CMakeCache.txt",
                   "/compile_commands.json", "/Testing/", "/toolchain/", "/cuda-stub/", "/package/")
# Parallel remote tests share one SSH connection; sshd allows 10 sessions on it by default.
REMOTE_TEST_JOBS = 8


def log(message: str) -> None:
    print(message, flush=True)


def configure_presets() -> list[str]:
    presets = json.loads(PRESETS_FILE.read_text())["configurePresets"]
    return [p["name"] for p in presets if not p.get("hidden")]


def test_presets() -> list[str]:
    presets = json.loads(PRESETS_FILE.read_text())["testPresets"]
    return [p["name"] for p in presets if not p.get("hidden")]


def build_dir(preset: str) -> pathlib.Path:
    return sdklib.REPO / "build" / preset  # CMakePresets.json's binaryDir


def ready_sdk() -> sdklib.Sdk:
    """The SDK this checkout's inputs describe; it must be set up."""
    sdk = sdklib.load()
    receipt = sdklib.read_receipt(sdk.root)
    if not receipt or receipt.get("identity") != sdk.identity or receipt.get("inputs") != sdk.inputs:
        raise SdkError(f"no SDK for this checkout at {sdk.root}; run `mise run setup`")
    return sdk


def run(cmd: list, env: dict | None = None) -> None:
    log("$ " + shlex.join(str(c) for c in cmd))
    result = subprocess.run([str(c) for c in cmd], cwd=sdklib.REPO, env=env)
    if result.returncode:
        raise SystemExit(result.returncode)


def sdk_env(sdk: sdklib.Sdk) -> dict:
    env = dict(os.environ, LLMP_SDK=str(sdk.root))
    # Only --host may select a remote run. Inherited runner controls could
    # otherwise test stale deployed binaries after building new local ones.
    for name in ("LLMP_TARGET_HOST", "LLMP_TARGET_DIR", "LLMP_TARGET_SSH_CONTROL"):
        env.pop(name, None)
    return env


def configured_sdk(preset: str) -> str | None:
    """The SDK root a build directory was configured with, if any."""
    try:
        for line in (build_dir(preset) / "CMakeCache.txt").read_text().splitlines():
            if line.startswith("LLMP_SDK:PATH="):
                return line.split("=", 1)[1]
    except OSError:
        pass
    return None


def configure_args(sdk: sdklib.Sdk, preset: str, fresh: bool, locked: bool) -> list[str]:
    args = ["--preset", preset, f"-DLLMP_SDK={sdk.root}"]
    # Explicit either way, so a checked build's setting does not stay in the cache.
    if locked:
        args += ["-DLLMP_REQUIRE_LOCKED_SOURCES=ON", "-DLLMP_MODULES="]
    else:
        args += ["-DLLMP_REQUIRE_LOCKED_SOURCES=OFF"]
    return args + (["--fresh"] if fresh else [])


def build(sdk: sdklib.Sdk, preset: str, fresh: bool, locked: bool = False) -> None:
    cmake = sdk.root / "bin" / "cmake"
    previous = configured_sdk(preset)
    if previous and os.path.normpath(previous) != os.path.normpath(sdk.root):
        # A build directory keeps its first compilers; another SDK needs a new cache.
        log(f"build/{preset} was configured with {previous}; configuring it afresh")
        fresh = True
    run([cmake, *configure_args(sdk, preset, fresh, locked)], sdk_env(sdk))
    run([cmake, "--build", "--preset", preset], sdk_env(sdk))


def ssh_control_path() -> str | None:
    """A connection-sharing socket for the deploy and its remote tests, if there is a private runtime dir."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    return f"{runtime}/llmp-ssh-%C" if runtime and os.path.isdir(runtime) else None


def ssh_base(control: str | None) -> list[str]:
    ssh = ["ssh", "-o", "BatchMode=yes"]
    if control:
        ssh += ["-o", "ControlMaster=auto", "-o", f"ControlPath={control}", "-o", "ControlPersist=120"]
    return ssh


def deploy(sdk: sdklib.Sdk, preset: str, host: str, control: str | None) -> str:
    """Copies the preset's build tree (less objects and CMake state) to host; returns the remote directory."""
    for tool in ("ssh", "rsync"):
        if shutil.which(tool) is None:
            raise SdkError(f"deploy needs {tool} on this host")
    local = build_dir(preset)
    tag = hashlib.sha256(str(local).encode()).hexdigest()[:16]
    remote = f".cache/llmp/deploy/{preset}-{tag}"
    # One command creates the directory, reports its absolute path and checks for rsync there.
    script = f'mkdir -p "$HOME"/{remote} && command -v rsync >/dev/null && printf "%s\\n" "$HOME"/{remote}'
    result = subprocess.run([*ssh_base(control), "--", host, script], capture_output=True, text=True)
    if result.returncode or not result.stdout.strip().startswith("/"):
        raise SdkError(f"cannot prepare {host}:~/{remote} (is rsync installed there?): "
                       f"{(result.stderr or result.stdout).strip()}")
    remote_dir = result.stdout.strip().splitlines()[-1]
    excludes = [f"--exclude={pattern}" for pattern in DEPLOY_EXCLUDES]
    run(["rsync", "-a", "--delete", "-e", shlex.join(ssh_base(control)), *excludes,
         f"{local}/", f"{host}:{remote_dir}/"])
    log(f"deployed {local} to {host}:{remote_dir}")
    return remote_dir


def package(sdk: sdklib.Sdk, fresh: bool) -> pathlib.Path:
    """Builds the release profile and its Debian package; returns the package's path."""
    preset = "cross"  # release packages come from the cross profile (D-071)
    build(sdk, preset, fresh, locked=True)
    out = build_dir(preset) / "package"
    shutil.rmtree(out, ignore_errors=True)
    try:
        control = packagelib.generate(build_dir(preset), sdk, out / "doc")
    except packagelib.PackageError as e:
        raise SdkError(str(e)) from None
    run([sdk.root / "bin" / "cpack", "--config", build_dir(preset) / "CPackConfig.cmake"], sdk_env(sdk))
    debs = sorted(out.glob("*.deb"))
    if len(debs) != 1:
        raise SdkError(f"cpack wrote {len(debs)} packages to {out}, not one")
    log(f"package: {debs[0]} ({control['version']}, {control['architecture']}; depends {control['depends']})")
    return debs[0]


def split_ctest_args(argv: list[str]) -> tuple[list[str], list[str]]:
    if "--" in argv:
        at = argv.index("--")
        return argv[:at], argv[at + 1:]
    return argv, []


def main() -> int:
    argv, ctest_args = split_ctest_args(sys.argv[1:])
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    commands = parser.add_subparsers(dest="command", required=True)
    for name, text in (("build", "configure and build"), ("test", "build, then run the tests")):
        sub = commands.add_parser(name, help=text)
        sub.add_argument("presets", nargs="*", metavar="PRESET")
        sub.add_argument("--fresh", action="store_true", help="configure from an empty cache")
        sub.add_argument("--locked", action="store_true", help="the core profile from locked sources only")
        if name == "test":
            where = sub.add_mutually_exclusive_group()
            where.add_argument("--host", help="run the cross build's tests on this host over SSH")
            where.add_argument("--gpu", action="store_true",
                               help="run only the native build's gpu-discrete tests on this host's GPU")
    sub = commands.add_parser("deploy", help="build, then copy the cross build to a host")
    sub.add_argument("preset", nargs="?", default="cross", metavar="PRESET")
    sub.add_argument("--host", required=True, help="the SSH host to copy to")
    sub.add_argument("--fresh", action="store_true", help="configure from an empty cache")
    sub.add_argument("--locked", action="store_true", help="the core profile from locked sources only")
    sub = commands.add_parser("package", help="build the cross preset --locked and its arm64 Debian package")
    sub.add_argument("--fresh", action="store_true", help="configure from an empty cache")
    args = parser.parse_args(argv)
    if ctest_args and args.command != "test":
        parser.error("arguments after `--` go to CTest, for `test` only")

    sdk = ready_sdk()
    if args.command == "package":
        package(sdk, args.fresh)
        return 0
    presets = args.presets if args.command != "deploy" else [args.preset]
    presets = presets or [DEFAULT_PRESET[sdk.arch]]
    known = configure_presets()
    for preset in presets:
        if preset not in known:
            parser.error(f"unknown preset {preset!r}; CMakePresets.json has {', '.join(known)}")
    remote = args.command == "deploy" or getattr(args, "host", None)
    if remote and args.host.startswith("-"):
        parser.error(f"--host {args.host!r} is not a host name")
    if remote:
        for preset in presets:
            if preset not in REMOTE_TEST_PRESET:
                parser.error(f"only a cross build runs on another host ({', '.join(REMOTE_TEST_PRESET)}), "
                             f"not {preset}; build spark-native on the Spark itself")
    elif args.command == "test":
        local_tests = test_presets()
        for preset in presets:
            if args.gpu and f"{preset}-gpu" not in local_tests:
                parser.error(f"{preset} has no discrete GPU tests; --gpu runs native's")
            if preset not in local_tests:
                parser.error(f"{preset}'s tests run only on a Spark: add --host HOST")

    control = ssh_control_path() if remote else None
    for preset in presets:
        build(sdk, preset, args.fresh, args.locked)
        if args.command == "deploy":
            deploy(sdk, preset, args.host, control)
        elif args.command == "test":
            ctest = sdk.root / "bin" / "ctest"
            if args.host:
                remote_dir = deploy(sdk, preset, args.host, control)
                env = sdk_env(sdk) | {"LLMP_TARGET_HOST": args.host, "LLMP_TARGET_DIR": remote_dir}
                if control:
                    env["LLMP_TARGET_SSH_CONTROL"] = control
                run([ctest, "--preset", REMOTE_TEST_PRESET[preset], "--parallel", REMOTE_TEST_JOBS,
                     *ctest_args], env)
            elif args.gpu:
                run([ctest, "--preset", f"{preset}-gpu", "--parallel", 1, *ctest_args], sdk_env(sdk))
            else:
                run([ctest, "--preset", preset, "--parallel", os.cpu_count() or 1, *ctest_args], sdk_env(sdk))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SdkError as e:
        print(f"build: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
