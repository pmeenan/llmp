"""Runs a cross-built executable for CTest: under qemu-user, or on a Spark over SSH (D-011, D-061).

CMake makes this the cross build's CROSSCOMPILING_EMULATOR, so CTest (and
GoogleTest discovery) call it as

    run-target --build-dir DIR --sysroot SYSROOT --qemu QEMU -- EXECUTABLE [ARGS...]

By default it runs EXECUTABLE locally under qemu-user with the target
sysroot's dynamic loader. With LLMP_TARGET_HOST set it runs EXECUTABLE on
that host instead, from LLMP_TARGET_DIR there, where `mise run deploy` copied
the build directory: paths under the build directory, in the arguments and the
working directory, map to that copy. `mise run test -- cross --host HOST` sets
both. Standard input and the exit status pass through.
"""

import sys

sys.dont_write_bytecode = True

import argparse
import os
import shlex

# Test-control variables that go with a remote run; the remote host's own
# environment supplies everything else.
FORWARD_PREFIXES = ("GTEST_", "LLMP_TEST_")
FORWARD_NAMES = ("ASAN_OPTIONS", "UBSAN_OPTIONS", "LSAN_OPTIONS", "TSAN_OPTIONS")


def map_path(value: str, build_dir: str, remote_dir: str) -> str:
    """Rewrites every occurrence of the build directory as a path prefix."""
    out, start = [], 0
    while (at := value.find(build_dir, start)) >= 0:
        end = at + len(build_dir)
        boundary_before = at == 0 or not (value[at - 1].isalnum() or value[at - 1] in "_-./")
        boundary_after = end == len(value) or value[end] == "/"
        out.append(value[start:at])
        out.append(remote_dir if boundary_before and boundary_after else build_dir)
        start = end
    out.append(value[start:])
    return "".join(out)


def remote_command(build_dir: str, remote_dir: str, cwd: str, argv: list[str], env: dict[str, str]) -> str:
    """The shell command that runs argv on the remote host."""
    remote_cwd = map_path(cwd, build_dir, remote_dir)
    if remote_cwd == cwd:  # CTest runs tests inside the build directory; anything else starts at its root
        remote_cwd = remote_dir
    forwarded = sorted(f"{k}={map_path(v, build_dir, remote_dir)}" for k, v in env.items()
                       if k.startswith(FORWARD_PREFIXES) or k in FORWARD_NAMES)
    command = [map_path(a, build_dir, remote_dir) for a in argv]
    return (f"cd {shlex.quote(remote_cwd)} && exec env"
            f"{''.join(' ' + shlex.quote(f) for f in forwarded)} {shlex.join(command)}")


def ssh_command(host: str, command: str, control: str | None) -> list[str]:
    ssh = ["ssh", "-o", "BatchMode=yes"]
    if control:
        ssh += ["-o", "ControlMaster=auto", "-o", f"ControlPath={control}", "-o", "ControlPersist=120"]
    return [*ssh, "--", host, command]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--build-dir", required=True)
    parser.add_argument("--sysroot", required=True)
    parser.add_argument("--qemu", required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("no executable to run")

    host = os.environ.get("LLMP_TARGET_HOST")
    if not host:
        env = dict(os.environ, QEMU_LD_PREFIX=args.sysroot)
        try:
            os.execvpe(args.qemu, [args.qemu, *command], env)
        except OSError as e:
            print(f"run-target: cannot run {args.qemu} ({e}); install qemu-user-static (D-061)", file=sys.stderr)
            return 127
    remote_dir = os.environ.get("LLMP_TARGET_DIR")
    if not remote_dir or not remote_dir.startswith("/"):
        print("run-target: LLMP_TARGET_HOST needs LLMP_TARGET_DIR, the absolute directory `mise run deploy` "
              "copied the build to; run the tests with `mise run test -- cross --host HOST`", file=sys.stderr)
        return 2
    build_dir = os.path.normpath(os.path.abspath(args.build_dir))
    remote = remote_command(build_dir, remote_dir.rstrip("/") or "/", os.getcwd(), command, dict(os.environ))
    ssh = ssh_command(host, remote, os.environ.get("LLMP_TARGET_SSH_CONTROL"))
    try:
        os.execvp(ssh[0], ssh)
    except OSError as e:
        print(f"run-target: cannot run ssh ({e})", file=sys.stderr)
        return 127


if __name__ == "__main__":
    sys.exit(main())
