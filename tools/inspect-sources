"""Read-only source validation shared by preparation, configure and build."""

import sys

sys.dont_write_bytecode = True

import argparse
import pathlib

from jitllm_sources import SourceError, load_lock, select, tree_digest


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--lock", type=pathlib.Path)
    mode.add_argument("--tree", type=pathlib.Path)
    parser.add_argument("--modules", default="")
    parser.add_argument("--cuda", choices=("on", "off"), help="select a build's CUDA/CPU closure")
    args = parser.parse_args()
    if args.tree is not None:
        print(tree_digest(args.tree))
    else:
        modules = [m for m in args.modules.split(",") if m]
        cuda = None if args.cuda is None else args.cuda == "on"
        select(load_lock(args.lock, modules=modules, cuda=cuda), modules, cuda=cuda)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (SourceError, OSError) as error:
        print(f"inspect-sources: {error}", file=sys.stderr)
        sys.exit(1)
