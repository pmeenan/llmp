"""Runs the confined-job proof (plan.md M1, D-074) in delegated cgroups.

    tools/job-proof                   here, in transient units of this user's systemd manager
    tools/job-proof --host HOST       on a Spark, as the llmp account, with llmp.service's settings

It runs tests/jobs/job_proof_test (build it first: `mise run build`, or
`mise run build -- cross` for --host) three times, each in a new transient
service with the delegation llmp.service has (Delegate=, DelegateSubgroup=
runtime): the job tests, then the two phases of a unit restart. With --host
the units run as `llmp` with every sandboxing setting of
packaging/llmp.service, which needs the package installed there and sudo;
the proof's binary is copied to /var/lib/llmp/job-proof/ and removed
afterwards.
"""

import sys

sys.dont_write_bytecode = True

import argparse
import configparser
import pathlib
import shlex
import subprocess

REPO = pathlib.Path(__file__).resolve().parent.parent
UNIT = REPO / "packaging" / "llmp.service"
# [Service] settings that describe the runtime's own process, not the
# environment a job runs in.
NOT_CARRIED = {"Type", "NotifyAccess", "ExecStart", "Restart", "RestartSec", "RestartPreventExitStatus",
               "TimeoutStopSec",
               # The service's own directories and IPC, which a transient unit
               # stopping beside a running service would remove.
               "ConfigurationDirectory", "StateDirectory", "StateDirectoryMode", "RuntimeDirectory", "RemoveIPC"}
REMOTE_DIR = "/var/lib/llmp/job-proof"


def unit_properties(user: bool) -> list[str]:
    """systemd-run --property arguments: the service's settings, or just its delegation for a user unit."""
    parser = configparser.RawConfigParser(strict=False, delimiters=("=",), comment_prefixes=("#",),
                                          empty_lines_in_values=False, dict_type=_MultiDict)
    parser.optionxform = str
    parser.read(UNIT)
    props = []
    for key, value in parser.items("Service"):
        for one in value.split("\n"):
            if user and key not in ("Delegate", "DelegateSubgroup"):
                continue
            if key not in NOT_CARRIED:
                props.append(f"--property={key}={one}")
    return props


class _MultiDict(dict):
    """Keeps every value of a repeated key (DeviceAllow=), newline-joined."""

    def __setitem__(self, key, value):
        if key in self and isinstance(value, list):
            self[key].extend(value)
        else:
            super().__setitem__(key, value)


def runs(binary: str, state: str) -> list[tuple[str, list[str], list[str]]]:
    return [
        ("job tests", ["LLMP_JOB_PROOF=1", f"LLMP_JOB_PROOF_STATE={state}"],
         [binary, "--gtest_filter=JobProof.*:Confinement.*"]),
        ("unit restart: start a job, then end the unit", ["LLMP_JOB_PROOF_PHASE=crash", f"LLMP_JOB_PROOF_STATE={state}"],
         [binary, "--gtest_filter=UnitRestart.*"]),
        ("unit restart: a new unit finds the job ended", ["LLMP_JOB_PROOF_PHASE=recover",
                                                          f"LLMP_JOB_PROOF_STATE={state}"],
         [binary, "--gtest_filter=UnitRestart.*"]),
    ]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--host", help="the Spark to run on, as llmp (needs the package and sudo there)")
    args = parser.parse_args()
    failed = []
    if args.host is None:
        binary = REPO / "build" / "native" / "tests" / "jobs" / "job_proof_test"
        state = subprocess.run(["mktemp", "-d"], capture_output=True, text=True, check=True).stdout.strip()
        try:
            for name, env, command in runs(str(binary), state):
                cmd = ["systemd-run", "--user", "--quiet", "--wait", "--pipe", *unit_properties(user=True),
                       *[f"--setenv={e}" for e in env], *command]
                print(f"=== {name}\n$ {shlex.join(cmd)}", flush=True)
                if subprocess.run(cmd).returncode:
                    failed.append(name)
        finally:
            subprocess.run(["rm", "-rf", state])
    else:
        if args.host.startswith("-"):
            parser.error(f"--host {args.host!r} is not a host name")
        binary = REPO / "build" / "cross" / "tests" / "jobs" / "job_proof_test"
        ssh = ["ssh", "-o", "BatchMode=yes", args.host]
        remote = f"{REMOTE_DIR}/job_proof_test"
        state = f"{REMOTE_DIR}/state"
        setup = (f"sudo install -d -o root -g root -m 0755 {REMOTE_DIR} && "
                 f"sudo install -o root -g root -m 0755 /dev/stdin {remote} && "
                 f"sudo install -d -o llmp -g llmp -m 0700 {state}")
        with open(binary, "rb") as data:
            if subprocess.run([*ssh, setup], stdin=data).returncode:
                print("job-proof: cannot install the proof on the host (is the llmp package installed?)")
                return 1
        try:
            for name, env, command in runs(remote, state):
                cmd = ["sudo", "systemd-run", "--quiet", "--wait", "--pipe", *unit_properties(user=False),
                       f"--property=ReadWritePaths={REMOTE_DIR}",
                       *[f"--setenv={e}" for e in env], *command]
                print(f"=== {name}\n$ {shlex.join(cmd)}", flush=True)
                if subprocess.run([*ssh, shlex.join(cmd)]).returncode:
                    failed.append(name)
        finally:
            subprocess.run([*ssh, f"sudo rm -rf {REMOTE_DIR}"])
    print("job-proof: " + (f"FAILED: {', '.join(failed)}" if failed else "passed"))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
