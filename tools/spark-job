"""Runs long work detached on a Spark, under a supervisor that always records how it ended.

    spark-job start --name N [--timeout S] [--gpu|--shared [--no-wait]] [-C DIR] -- CMD [ARGS...]
    spark-job start --name N --steps FILE [--step-timeout S] [--stop-on-fail] ...
    spark-job status [NAME] [--json]      running, done, failed, timed-out, killed or lost
    spark-job wait NAME [--timeout S]     blocks until a final state; 0 only for success
    spark-job tail NAME [-n N] [-f]
    spark-job kill NAME
    spark-job gc [--older-than HOURS]     removes old finished jobs
    spark-job busy                        what runs here: exit 0 free, 1 busy, 3 shared jobs only

Run it on the Spark (over ssh from the workstation). `start` launches a
supervisor in its own session, which runs CMD in a process group of its own
with stdout and stderr in the job's log, and returns at once. The supervisor,
not CMD, writes the job's final status on every end it can see: an exit, a
signal, a timeout (the group gets SIGTERM, then SIGKILL after --grace
seconds), `spark-job kill`, or an error of its own. A supervisor that dies
without writing one (SIGKILL, a reboot) leaves the job `lost`, which `status`
and `wait` detect from its pid. `wait` never looks for a marker in the log.

With --steps, FILE holds one shell command per line (blank lines and `#`
comments skipped), run in order by bash; each step's status is recorded and
a failed step does not stop the rest unless --stop-on-fail. Job state lives
in $LLMP_JOBS_DIR, else $XDG_DATA_HOME/llmp/jobs, else
~/.local/share/llmp/jobs, one directory per name: job.json (what was
started, where, by which supervisor), gpu.json (its admission), child.json
(the running step's process group), steps.json (queue progress), final.json
(how it ended) and log.

Two classes of job share a host. An exclusive job (--gpu: measurements,
gate runs, timing-sensitive and model tests) runs alone: it waits until no
other exclusive or shared job runs, and while it waits no new shared job
starts, so a stream of shared jobs cannot starve it. Shared jobs (--shared:
builds and other functional tests) run up to $LLMP_JOBS_SHARED at a time
(default 2), never beside an exclusive job. A job given neither flag takes
no lock and runs at once. The locks are flocks in the state directory:
.gpu.lock (exclusive for --gpu, shared for --shared), .gate.lock (held by an
exclusive job while it waits) and .shared.<i>.lock (one per shared slot).
They hold only on a local file system, and only while nobody removes the
files: a job that opens a recreated file locks a different one. The supervisor and its child hold their locks for the job's whole life, so
the kernel drops them once both have exited, however the job ends: a lost
supervisor does not admit other work while its child survives. Admission
also checks lost jobs' surviving process groups, since a wrapper's
descendants may close the inherited descriptors: a lost exclusive job's
group keeps out every job, a lost shared job's group keeps its slot and
keeps out exclusive jobs. A waiting job shows as "waiting for the GPU"
(exclusive) or "waiting for a shared slot" in `status` and `busy`, logging
what it waits for once a minute; its --timeout counts from its admission,
and `kill` ends the wait. With --no-wait, `start` takes the locks itself and
refuses at once if the job cannot be admitted now. The locks cover spark-job
jobs only: GPU work started outside spark-job is still visible only through
`busy`'s nvidia-smi listing.
"""

import sys

sys.dont_write_bytecode = True

import argparse
import errno
import fcntl
import json
import os
import pathlib
import re
import shlex
import shutil
import signal
import socket
import subprocess
import time

FINAL_STATES = ("done", "failed", "timed-out", "killed")
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")
POLL = 0.2  # the supervisor's poll of its child, seconds
WAIT_POLL = 1.0  # wait's poll of the job, seconds
GPU_POLL = 1.0  # a waiting supervisor's retry of its admission, seconds
GPU_NOTE = 60.0  # how often a waiting supervisor logs what it waits for, seconds
SHARED_DEFAULT = 2  # concurrent shared jobs per host unless $LLMP_JOBS_SHARED says otherwise
# An exclusive job's tries of the gate per admission attempt, and the seconds
# between them: a shared job holds it only while it takes the class lock.
GATE_TRIES = 5
GATE_RETRY = 0.01
BUSY_EXIT = 1  # `busy`: an exclusive job runs, waits or survives, or unattributed GPU work runs
SHARED_EXIT = 3  # `busy`: only shared jobs run or wait


# ---------------------------------------------------------------- state files

def jobs_root() -> pathlib.Path:
    if os.environ.get("LLMP_JOBS_DIR"):
        return pathlib.Path(os.environ["LLMP_JOBS_DIR"])
    data = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    return pathlib.Path(data) / "llmp" / "jobs"


def shared_slots() -> int:
    """How many shared jobs may run at once on this host."""
    value = os.environ.get("LLMP_JOBS_SHARED")
    if not value:
        return SHARED_DEFAULT
    if not value.isdigit() or int(value) < 1:
        sys.exit(f"spark-job: LLMP_JOBS_SHARED={value!r} is not a positive whole number")
    return int(value)


def gpu_lock_path(root: pathlib.Path) -> pathlib.Path:
    return root / ".gpu.lock"


def gate_lock_path(root: pathlib.Path) -> pathlib.Path:
    return root / ".gate.lock"


def slot_lock_path(root: pathlib.Path, slot: int) -> pathlib.Path:
    return root / f".shared.{slot}.lock"


def job_class(info: dict) -> str | None:
    """exclusive, shared or None (no lock); a record from before --shared has only `gpu`."""
    return info.get("class") or ("exclusive" if info.get("gpu") else None)


def scan_jobs(root: pathlib.Path) -> list[dict]:
    """Every job's state; an entry removed during the scan is skipped."""
    if not root.is_dir():
        return []
    infos = []
    for directory in sorted(d for d in root.iterdir() if d.is_dir()):
        try:
            infos.append(job_state(directory))
        except FileNotFoundError:
            # gc and completed-name reuse may remove an entry after the
            # scan. Both already refuse to remove surviving orphan groups.
            continue
    return infos


def lock_orphans(root: pathlib.Path) -> list[dict]:
    """Local --gpu and --shared jobs whose supervisor is lost but process group survives."""
    return [i for i in scan_jobs(root) if i["state"] == "lost" and job_class(i) and i.get("orphans")]


def try_flock(fd: int, mode: int) -> bool:
    """Takes a flock without blocking; False if a conflicting one is held."""
    try:
        fcntl.flock(fd, mode | fcntl.LOCK_NB)
        return True
    except OSError as e:
        if e.errno in (errno.EAGAIN, errno.EACCES):
            return False
        raise


class Admission:
    """One job's locks: tries to admit it without blocking, and keeps what it took.

    An exclusive job holds .gpu.lock exclusively. A shared job holds it shared,
    plus one .shared.<i>.lock exclusively. An exclusive job holds .gate.lock
    exclusively while it waits; a shared job takes it shared only while it
    takes .gpu.lock, so no shared job is admitted while an exclusive one waits.
    """

    def __init__(self, root: pathlib.Path, cls: str, slots: int):
        self.root, self.cls, self.slots = root, cls, slots
        self.gpu_fd = os.open(gpu_lock_path(root), os.O_RDWR | os.O_CREAT, 0o644)
        self.gate_fd = os.open(gate_lock_path(root), os.O_RDWR | os.O_CREAT, 0o644)
        self.gate_held = False
        self.slot_fd = None
        self.slot = None

    def fds(self) -> tuple[int, ...]:
        """The descriptors the supervisor and its child inherit (never the gate)."""
        return tuple(fd for fd in (self.gpu_fd, self.slot_fd) if fd is not None)

    def try_admit(self) -> bool:
        return self._exclusive() if self.cls == "exclusive" else self._shared()

    def _exclusive(self) -> bool:
        # The gate first, kept while waiting: it keeps new shared jobs out
        # (writer preference). Another exclusive job may hold it as it waits.
        for attempt in range(GATE_TRIES):
            self.gate_held = self.gate_held or try_flock(self.gate_fd, fcntl.LOCK_EX)
            if self.gate_held:
                break
            if attempt + 1 < GATE_TRIES:
                time.sleep(GATE_RETRY)
        if not self.gate_held or not try_flock(self.gpu_fd, fcntl.LOCK_EX):
            return False
        # A wrapper may close descriptors in a subprocess before exiting.
        # Its surviving group must still retire before another job starts.
        if lock_orphans(self.root):
            fcntl.flock(self.gpu_fd, fcntl.LOCK_UN)
            return False
        self.release_gate()
        return True

    def _shared(self) -> bool:
        # The gate only in passing: refused while an exclusive job waits.
        if not try_flock(self.gate_fd, fcntl.LOCK_SH):
            return False
        try:
            if not try_flock(self.gpu_fd, fcntl.LOCK_SH):
                return False
        finally:
            fcntl.flock(self.gate_fd, fcntl.LOCK_UN)
        lost = lock_orphans(self.root)
        if not any(job_class(i) == "exclusive" for i in lost):
            kept = {i.get("slot") for i in lost}  # a lost shared job's group keeps its slot
            for slot in range(self.slots):
                if slot in kept:
                    continue
                fd = os.open(slot_lock_path(self.root, slot), os.O_RDWR | os.O_CREAT, 0o644)
                if try_flock(fd, fcntl.LOCK_EX):
                    self.slot_fd, self.slot = fd, slot
                    return True
                os.close(fd)
        # Never keep the class lock while waiting for a slot: it would keep
        # a waiting exclusive job out.
        fcntl.flock(self.gpu_fd, fcntl.LOCK_UN)
        return False

    def release_gate(self) -> None:
        if self.gate_fd is not None:
            os.close(self.gate_fd)  # drops the gate if it was held
            self.gate_fd = None
            self.gate_held = False

    def close(self) -> None:
        """Gives up every lock (a refused --no-wait start)."""
        self.release_gate()
        for fd in self.fds():
            os.close(fd)
        self.gpu_fd = self.slot_fd = None


def blockers(root: pathlib.Path, me: str | None = None) -> str:
    """What holds the host or waits for it, as far as the jobs recorded it."""
    infos = [i for i in scan_jobs(root) if i["name"] != me]
    parts = []
    for info in infos:
        cls = job_class(info)
        if not cls:
            continue
        if info["state"] == "lost" and info.get("orphans"):
            parts.append(f"{info['name']} ({cls}; its supervisor is lost; its process group still runs)")
        elif info["state"] == "running" and info.get("admitted"):
            parts.append(f"{info['name']} ({cls}, running for {span(time.time() - info['admitted'])})")
    waiting = [i["name"] for i in infos if i["state"] == "running" and job_class(i) == "exclusive"
               and not i.get("admitted")]
    if waiting:
        parts.append(f"exclusive job(s) waiting: {', '.join(waiting)}")
    return "; ".join(parts) or "another job"


def read_json(path: pathlib.Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def write_json(path: pathlib.Path, value: dict) -> None:
    """Replaces path atomically, so a reader sees the old or the new file, never half of one."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(value, indent=1) + "\n")
    os.replace(tmp, path)


def now() -> float:
    return round(time.time(), 3)


def stamp(t: float) -> str:
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(t))


def span(seconds: float) -> str:
    seconds = int(max(seconds, 0))
    if seconds < 120:
        return f"{seconds}s"
    if seconds < 7200:
        return f"{seconds // 60}m"
    if seconds < 172800:
        return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d"


# ---------------------------------------------------------------- processes

def proc_stat(pid: int) -> tuple[str, int] | None:
    """The process's state letter and start time in clock ticks, or None if there is no such process.

    The start time tells a reused pid from the process recorded under it.
    """
    try:
        stat = pathlib.Path(f"/proc/{pid}/stat").read_text()
    except (FileNotFoundError, ProcessLookupError, PermissionError):
        return None
    fields = stat[stat.rindex(")") + 2:].split()  # fields from 3 (state) on
    return fields[0], int(fields[19])  # fields 3 and 22


def supervisor_alive(sup: dict) -> bool:
    stat = proc_stat(sup["pid"])
    return stat is not None and stat[0] not in ("Z", "X") and stat[1] == sup["start_ticks"]


def group_alive(pgid: int | None) -> bool:
    if not pgid:
        return False
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def signal_group(pgid: int, sig: int) -> None:
    try:
        os.killpg(pgid, sig)
    except ProcessLookupError:
        pass


def stop_group(proc: subprocess.Popen | None, pgid: int, grace: float) -> None:
    """SIGTERM to the whole group, then SIGKILL to whatever is left after grace seconds."""
    signal_group(pgid, signal.SIGTERM)
    deadline = time.monotonic() + grace
    while time.monotonic() < deadline:
        if proc is not None:
            proc.poll()  # reap the leader, so a zombie does not keep the group "alive"
        if not group_alive(pgid):
            return
        time.sleep(POLL)
    signal_group(pgid, signal.SIGKILL)
    if proc is not None:
        proc.wait()


# ---------------------------------------------------------------- job state

def job_state(job_dir: pathlib.Path) -> dict:
    """The job's files merged, with `state` one of starting, running, lost, remote or a final state.

    A --gpu or --shared job also has `class`, `admitted` (when it was
    admitted), `gpu_waiting` (since when it waits, once it has failed a try)
    and `slot` (a shared job's slot).
    """
    job = read_json(job_dir / "job.json")
    if job is None or "supervisor" not in job:  # `start` is between its writes, or died in them
        info = {"name": job_dir.name, "state": "starting", "dir": str(job_dir), **(job or {})}
        if time.time() - job_dir.stat().st_mtime > 60:
            info.update(state="lost", reason="`start` never recorded a supervisor")
        return info
    info = dict(job, dir=str(job_dir))
    info["class"] = job_class(job)
    info["steps"] = (read_json(job_dir / "steps.json") or {}).get("steps")
    if info["class"]:
        gpu = read_json(job_dir / "gpu.json") or {}
        if gpu.get("acquired"):
            info["admitted"] = gpu["acquired"]
        if gpu.get("slot") is not None:
            info["slot"] = gpu["slot"]
    final = read_json(job_dir / "final.json")
    if final is None:
        if job.get("host") != socket.gethostname():
            info["state"] = "remote"  # a shared state directory; its pids mean nothing here
        elif supervisor_alive(job["supervisor"]):
            info["state"] = "running"
            gpu = read_json(job_dir / "gpu.json") or {}
            if gpu.get("waiting_since") and not gpu.get("acquired"):
                info["gpu_waiting"] = gpu["waiting_since"]
        else:
            final = read_json(job_dir / "final.json")  # it may have finished since the first read
            if final is None:
                info["state"] = "lost"
                info["reason"] = "the supervisor is gone and wrote no final status"
                child = read_json(job_dir / "child.json") or {}
                info["orphans"] = group_alive(child.get("pgid"))
    if final is not None:
        info.update(final)
    return info


def describe(info: dict) -> str:
    state = info["state"]
    if state in ("done", "failed") and info.get("signal"):
        return f"{state} (signal {info['signal']})"
    if state in ("done", "failed") and info.get("rc") is not None:
        return f"{state} (rc {info['rc']})"
    if state == "running" and info.get("gpu_waiting"):
        what = "a shared slot" if job_class(info) == "shared" else "the GPU"
        return f"waiting for {what} ({span(time.time() - info['gpu_waiting'])})"
    if state == "running" and info.get("steps"):
        done = sum(1 for s in info["steps"] if s["state"] not in ("pending", "running"))
        return f"running (step {min(done + 1, len(info['steps']))}/{len(info['steps'])})"
    if state == "lost" and info.get("orphans"):
        return "lost (its process group is still alive; `spark-job kill` stops it)"
    return state


def job_dir_for(name: str) -> pathlib.Path:
    if not NAME_RE.fullmatch(name):
        sys.exit(f"spark-job: bad job name {name!r} (letters, digits, '.', '_', '-'; at most 64)")
    return jobs_root() / name


def existing_job(name: str) -> pathlib.Path:
    job_dir = job_dir_for(name)
    if not job_dir.is_dir():
        print(f"spark-job: no job named {name!r} in {jobs_root()}", file=sys.stderr)
        sys.exit(2)
    return job_dir


def tail_lines(path: pathlib.Path, count: int) -> list[str]:
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(f.tell() - 256 * 1024, 0))
            data = f.read()
    except FileNotFoundError:
        return []
    return data.decode(errors="replace").splitlines()[-count:]


def print_steps(info: dict) -> None:
    for i, step in enumerate(info.get("steps") or [], 1):
        detail = f"signal {step['signal']}" if step.get("signal") else (
            f"rc {step['rc']}" if step.get("rc") is not None else "")
        took = f" {span(step['end'] - step['start'])}" if step.get("end") else ""
        print(f"  step {i}: {step['state']:<9} {detail:<14}{took}  {step['cmd']}")


# ---------------------------------------------------------------- start

def cmd_start(args: argparse.Namespace) -> int:
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if bool(command) == bool(args.steps):
        sys.exit("spark-job start: give either -- CMD... or --steps FILE")
    if args.gpu and args.shared:
        sys.exit("spark-job start: give --gpu (exclusive) or --shared, not both")
    cls = "exclusive" if args.gpu else ("shared" if args.shared else None)
    if args.no_wait and not cls:
        sys.exit("spark-job start: --no-wait applies to --gpu and --shared jobs only")
    slots = shared_slots() if cls == "shared" else None
    steps = None
    if args.steps:
        lines = pathlib.Path(args.steps).read_text().splitlines()
        steps = [s.strip() for s in lines if s.strip() and not s.strip().startswith("#")]
        if not steps:
            sys.exit(f"spark-job start: {args.steps} has no steps")
    cwd = os.path.abspath(args.cwd or os.getcwd())
    if not os.path.isdir(cwd):
        sys.exit(f"spark-job start: {cwd} is not a directory")
    job_dir = job_dir_for(args.name)
    root = jobs_root()
    root.mkdir(parents=True, exist_ok=True)
    with open(root / ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)  # two starts of one name cannot both pass the check
        if job_dir.exists():
            info = job_state(job_dir)
            if info["state"] in ("starting", "running", "remote") or info.get("orphans"):
                print(f"spark-job: {args.name!r} is {describe(info)}; pick another name or kill it",
                      file=sys.stderr)
                return 1
            shutil.rmtree(job_dir)  # a finished or lost job of that name is replaced
        admission = None
        if args.no_wait:  # admit here, so the refusal is immediate; the supervisor inherits the locks
            admission = Admission(root, cls, slots)
            if not admission.try_admit():
                admission.close()
                what = "the GPU is held by" if cls == "exclusive" else "no shared slot:"
                print(f"spark-job: {what} {blockers(root)}; not started (--no-wait)", file=sys.stderr)
                return 1
            admission.release_gate()
        job_dir.mkdir()
        log = job_dir / "log"
        # Steps run with the caller's umask, never looser than 022, so that what a step creates
        # is not group- or world-writable (no longer a requirement of llmpalooza's, D-073 as
        # amended on 2026-10-09, but `llmp doctor` warns of world-writable roles).
        caller_umask = os.umask(0o022)
        os.umask(caller_umask)
        job = {"name": args.name, "host": socket.gethostname(), "cwd": cwd, "log": str(log),
               "command": command or None, "steps_file": os.path.abspath(args.steps) if steps else None,
               "class": cls, "gpu": cls == "exclusive", "shared_slots": slots,
               "timeout": args.timeout, "step_timeout": args.step_timeout,
               "grace": args.grace, "stop_on_fail": args.stop_on_fail, "start": now(),
               "umask": caller_umask | 0o022,
               "lock_fds": list(admission.fds()) if admission else None,
               "lock_slot": admission.slot if admission else None}
        if steps:
            write_json(job_dir / "steps.json", {"steps": [{"cmd": s, "state": "pending"} for s in steps]})
        if admission:  # admitted already: so `status`, `busy` and refusals say so before the supervisor does
            write_json(job_dir / "gpu.json", {"acquired": now(), "slot": admission.slot})
        write_json(job_dir / "job.json", job)
        with open(log, "ab") as out:
            sup = subprocess.Popen([sys.executable, "-B", os.path.abspath(__file__), "_supervise",
                                    str(job_dir)], cwd=cwd, stdin=subprocess.DEVNULL, stdout=out,
                                   stderr=out, start_new_session=True,
                                   pass_fds=admission.fds() if admission else ())
        # The supervisor shares the locks' open file descriptions, so the locks stay held after
        # these copies of the descriptors close.
        if admission:
            admission.close()
        # The supervisor is still this process's child here (a zombie at worst), so its pid is its own.
        job["supervisor"] = {"pid": sup.pid, "start_ticks": proc_stat(sup.pid)[1]}
        write_json(job_dir / "job.json", job)
    print(f"started {args.name} (supervisor pid {sup.pid}{', ' + cls if cls else ''}); log {log}")
    print(f"wait with: {shlex.join([os.path.abspath(__file__), 'wait', args.name])}")
    return 0


# ---------------------------------------------------------------- supervisor

class Supervisor:
    def __init__(self, job_dir: pathlib.Path):
        self.dir = job_dir
        self.job = read_json(job_dir / "job.json")
        self.stop_reason = None
        self.log = open(job_dir / "log", "ab", buffering=0)
        self.deadline = None  # set once the job may run (after admission for a --gpu or --shared job)
        self.lock_fds = ()  # held, never closed, until this process ends

    def start_clock(self) -> None:
        self.deadline = time.monotonic() + self.job["timeout"] if self.job["timeout"] else None

    def admit(self) -> dict | None:
        """Holds the job's locks, waiting for them; a final outcome if killed meanwhile."""
        root = self.dir.parent
        cls = job_class(self.job)
        what = "the GPU" if cls == "exclusive" else "a shared slot"
        passed = self.job.get("lock_fds")
        if passed is None and self.job.get("gpu_fd") is not None:
            passed = [self.job["gpu_fd"]]  # from a `start` older than --shared, as this file is replaced
        if passed:  # `start --no-wait` took them and passed them on
            self.lock_fds = tuple(passed)
            slot = self.job.get("lock_slot")
        else:
            admission = Admission(root, cls, self.job.get("shared_slots") or SHARED_DEFAULT)
            began = time.monotonic()
            last_note = None
            while not admission.try_admit():
                if self.stop_reason:
                    return {"state": "killed", "reason": f"{self.stop_reason}, waiting for {what}"}
                if last_note is None:
                    write_json(self.dir / "gpu.json", {"waiting_since": now()})
                if last_note is None or time.monotonic() - last_note >= GPU_NOTE:
                    self.note(f"waiting for {what}: held by {blockers(root, self.job['name'])}")
                    last_note = time.monotonic()
                time.sleep(GPU_POLL)
            if self.stop_reason:  # killed during the last sleep, as the host came free: never start
                return {"state": "killed", "reason": f"{self.stop_reason}, waiting for {what}"}
            if last_note is not None:
                self.note(f"got {what} after waiting {span(time.monotonic() - began)}")
            admission.release_gate()
            self.lock_fds = admission.fds()
            slot = admission.slot
        write_json(self.dir / "gpu.json", {"acquired": now(), "slot": slot})
        if cls == "exclusive":  # what older copies of this tool read
            write_json(root / ".gpu.json", {"name": self.job["name"], "supervisor_pid": os.getpid(),
                                            "since": now()})
        return None

    def note(self, text: str) -> None:
        self.log.write(f"[spark-job {stamp(time.time())}] {text}\n".encode())

    def on_signal(self, signum, _frame) -> None:
        self.stop_reason = f"killed: the supervisor got {signal.Signals(signum).name}"

    def job_stop(self) -> dict | None:
        """Why the whole job must stop now (a kill or its --timeout), or None."""
        if self.stop_reason:
            return {"state": "killed", "reason": self.stop_reason}
        if self.deadline and time.monotonic() > self.deadline:
            return {"state": "timed-out", "reason": f"the job's --timeout of {self.job['timeout']}s"}
        return None

    def run_one(self, argv: list[str], step_timeout: float | None) -> dict:
        """Runs argv in a new process group; returns its outcome as state, rc, signal and reason."""
        started = time.monotonic()
        try:
            proc = subprocess.Popen(argv, cwd=self.job["cwd"], stdin=subprocess.DEVNULL, stdout=self.log,
                                    stderr=self.log, start_new_session=True, pass_fds=self.lock_fds,
                                    umask=self.job.get("umask", 0o022))
        except OSError as e:
            self.note(f"cannot start {shlex.join(argv)}: {e}")
            return {"state": "failed", "rc": 127, "reason": f"cannot start: {e}"}
        write_json(self.dir / "child.json", {"pid": proc.pid, "pgid": proc.pid})
        outcome = None
        while proc.poll() is None:
            outcome = self.job_stop()
            if not outcome and step_timeout and time.monotonic() - started > step_timeout:
                outcome = {"state": "timed-out", "reason": f"the --step-timeout of {step_timeout}s"}
            if outcome:
                self.note(f"stopping process group {proc.pid}: {outcome['reason']}")
                stop_group(proc, proc.pid, self.job["grace"])
                break
            time.sleep(POLL)
        if group_alive(proc.pid):  # the leader exited but left processes behind in its group
            self.note(f"stopping what is left of process group {proc.pid}")
            stop_group(None, proc.pid, self.job["grace"])
        rc = proc.returncode
        outcome = outcome or {"state": "done" if rc == 0 else "failed"}
        outcome.update(rc=rc if rc >= 0 else None, signal=signal.Signals(-rc).name if rc < 0 else None)
        return outcome

    def run(self) -> dict:
        if job_class(self.job):
            killed = self.admit()
            if killed:
                self.note(f"end: {describe(killed)}")
                return killed
        self.start_clock()
        if self.job["command"]:
            self.note(f"start: {shlex.join(self.job['command'])}")
            final = self.run_one(self.job["command"], None)
            self.note(f"end: {describe(final)}")
            return final
        steps = read_json(self.dir / "steps.json")["steps"]
        stopped = None  # why the queue stopped early, if it did
        for i, step in enumerate(steps, 1):
            stopped = stopped or self.job_stop()
            if stopped:
                step["state"] = "skipped"
                continue
            self.note(f"step {i}/{len(steps)} start: {step['cmd']}")
            step.update(state="running", start=now())
            write_json(self.dir / "steps.json", {"steps": steps})
            step.update(self.run_one(["bash", "-c", step["cmd"]], self.job["step_timeout"]), end=now())
            self.note(f"step {i}/{len(steps)} end: {describe(step)}")
            write_json(self.dir / "steps.json", {"steps": steps})
            if step["state"] != "done" and self.job["stop_on_fail"]:
                stopped = {"state": "failed", "reason": f"--stop-on-fail after step {i}"}
        write_json(self.dir / "steps.json", {"steps": steps})  # the skipped ones
        failed =[i for i, s in enumerate(steps, 1) if s["state"] != "done"]
        final = dict(stopped or {"state": "failed" if failed else "done"})
        final["rc"] = 0 if final["state"] == "done" else 1
        if failed:
            final["reason"] = "; ".join(filter(None, [final.get("reason"),
                                                      f"steps not done: {', '.join(map(str, failed))}"]))
        self.note(f"queue end: {final['state']}; {len(steps) - len(failed)}/{len(steps)} steps done")
        return final


def cmd_supervise(args: argparse.Namespace) -> int:
    job_dir = pathlib.Path(args.job_dir)
    try:
        sup = Supervisor(job_dir)
        for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            signal.signal(signum, sup.on_signal)
        final = sup.run()
    except BaseException as e:  # the supervisor's own failure is recorded too, never left as a hang
        child = read_json(job_dir / "child.json") or {}
        if group_alive(child.get("pgid")):
            stop_group(None, child["pgid"], 10)
        final = {"state": "failed", "rc": None, "reason": f"supervisor error: {e!r}"}
    final.update(end=now(), supervisor_pid=os.getpid())
    write_json(job_dir / "final.json", final)
    return 0


# ---------------------------------------------------------------- queries

def cmd_status(args: argparse.Namespace) -> int:
    if args.name:
        info = job_state(existing_job(args.name))
        if args.json:
            print(json.dumps(info, indent=1))
            return 0
        what = shlex.join(info["command"]) if info.get("command") else f"steps from {info.get('steps_file')}"
        cls = job_class(info)
        print(f"{info['name']}: {describe(info)}{f'  [{cls}]' if cls else ''}")
        print(f"  host {info.get('host')}, started {stamp(info.get('start', 0))}"
              f" ({span(time.time() - info.get('start', 0))} ago)"
              + (f", ended {stamp(info['end'])}" if info.get("end") else ""))
        print(f"  {what}\n  cwd {info.get('cwd')}\n  log {info.get('log')}")
        if info.get("reason"):
            print(f"  reason: {info['reason']}")
        print_steps(info)
        return 0
    root = jobs_root()
    infos = scan_jobs(root)
    if args.json:
        print(json.dumps(infos, indent=1))
        return 0
    for info in infos:
        age = span(time.time() - info.get("start", time.time()))
        stale = info.get("end") and time.time() - info["end"] > args.stale_hours * 3600
        what = shlex.join(info["command"]) if info.get("command") else f"steps {info.get('steps_file')}"
        cls = {"exclusive": "excl", "shared": "shrd"}.get(job_class(info), "")
        print(f"{info['name']:<24} {describe(info):<30} {age:>6} {cls:<4}"
              f"{' STALE' if stale else ''}  {what[:60]}")
    if not infos:
        print(f"no jobs in {root}")
    return 0


def cmd_wait(args: argparse.Namespace) -> int:
    job_dir = existing_job(args.name)
    deadline = time.monotonic() + args.timeout if args.timeout else None
    while True:
        if not job_dir.is_dir():
            print(f"spark-job: {args.name} was removed while waiting", file=sys.stderr)
            return 2
        info = job_state(job_dir)
        if info["state"] in FINAL_STATES + ("lost",):
            break
        if info["state"] == "remote":
            print(f"spark-job: {args.name} runs on {info.get('host')}; wait there", file=sys.stderr)
            return 2
        if deadline and time.monotonic() > deadline:
            print(f"spark-job: gave up waiting after {args.timeout}s; {args.name} is {describe(info)}",
                  file=sys.stderr)
            return 3
        time.sleep(WAIT_POLL)
    ok = info["state"] == "done"
    print(f"{args.name}: {describe(info)}" + (f"; {info['reason']}" if info.get("reason") else ""))
    print_steps(info)
    if not ok:
        print(f"--- last {args.lines} lines of {info.get('log')} ---")
        for line in tail_lines(pathlib.Path(info.get("log", job_dir / "log")), args.lines):
            print(line)
    return 0 if ok else 1


def cmd_tail(args: argparse.Namespace) -> int:
    job_dir = existing_job(args.name)
    log = job_dir / "log"
    for line in tail_lines(log, args.lines):
        print(line)
    if not args.follow:
        return 0
    with open(log, "rb") as f:
        f.seek(0, os.SEEK_END)
        while True:
            chunk = f.read()
            if chunk:
                sys.stdout.write(chunk.decode(errors="replace"))
                sys.stdout.flush()
            elif job_state(job_dir)["state"] not in ("starting", "running"):
                sys.stdout.write(f.read().decode(errors="replace"))  # what came before the end
                return 0
            else:
                time.sleep(WAIT_POLL)


def cmd_kill(args: argparse.Namespace) -> int:
    job_dir = existing_job(args.name)
    info = job_state(job_dir)
    if info["state"] == "running":
        try:
            os.kill(info["supervisor"]["pid"], signal.SIGTERM)  # it stops the group and records the kill
        except ProcessLookupError:
            pass  # it ended meanwhile; the state read below says how
        deadline = time.monotonic() + info.get("grace", 10) + 10
        while time.monotonic() < deadline:
            info = job_state(job_dir)
            if info["state"] != "running":
                break
            time.sleep(POLL)
    elif info["state"] == "lost" and info.get("orphans"):
        pgid = (read_json(job_dir / "child.json") or {})["pgid"]
        stop_group(None, pgid, info.get("grace", 10))
        info = job_state(job_dir)
    print(f"{args.name}: {describe(info)}")
    return 0 if info["state"] in FINAL_STATES + ("lost",) and not info.get("orphans") else 1


def cmd_gc(args: argparse.Namespace) -> int:
    root = jobs_root()
    if not root.is_dir():
        return 0
    cutoff = time.time() - args.older_than * 3600
    for job_dir in sorted(d for d in root.iterdir() if d.is_dir()):
        info = job_state(job_dir)
        ended = info.get("end") or info.get("start", time.time())
        if info["state"] in FINAL_STATES + ("lost",) and not info.get("orphans") and ended < cutoff:
            print(f"removing {info['name']} ({describe(info)}, ended {span(time.time() - ended)} ago)")
            if not args.dry_run:
                shutil.rmtree(job_dir)
    return 0


def gpu_processes() -> list[str] | None:
    try:
        out = subprocess.run(["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory",
                              "--format=csv,noheader"], capture_output=True, text=True, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    return [line.strip() for line in out.stdout.splitlines() if line.strip()] if out.returncode == 0 else None


def cmd_busy(args: argparse.Namespace) -> int:
    infos = scan_jobs(jobs_root())
    slots = shared_slots()

    def of(cls: str) -> tuple[list[dict], list[dict], list[dict]]:
        mine = [i for i in infos if job_class(i) == cls]
        running = [i for i in mine if i["state"] == "running" and i.get("admitted")]
        lost = [i for i in mine if i["state"] == "lost" and i.get("orphans")]
        waiting = [i for i in mine if i["state"] == "running" and not i.get("admitted")]
        return running, lost, waiting

    exclusive, exclusive_lost, exclusive_waiting = of("exclusive")
    shared, shared_lost, shared_waiting = of("shared")
    others = [i for i in infos if i["state"] == "running" and not job_class(i)]
    for info in exclusive + shared:
        slot = f", slot {info['slot']}" if info.get("slot") is not None else ""
        print(f"{job_class(info)} job {info['name']} running for {span(time.time() - info['admitted'])}"
              f"{slot} (cwd {info['cwd']})")
    for info in exclusive_lost + shared_lost:
        print(f"{job_class(info)} job {info['name']} has a lost supervisor and a running child "
              f"(cwd {info['cwd']})")
    for info in sorted(exclusive_waiting + shared_waiting, key=lambda i: i.get("gpu_waiting", i["start"])):
        what = "the GPU" if job_class(info) == "exclusive" else "a shared slot"
        since = info.get("gpu_waiting", info["start"])
        print(f"{job_class(info)} job {info['name']} waiting for {what} for {span(time.time() - since)}"
              f" (cwd {info['cwd']})")
    if others:
        print(f"also running (no lock): {', '.join(i['name'] for i in others)}")
    procs = gpu_processes()
    unattributed = 0
    if procs is None:
        print("nvidia-smi: not available")
    else:
        # A waiting job has no child yet.
        groups = {(read_json(pathlib.Path(i["dir"]) / "child.json") or {}).get("pgid"): i
                  for i in exclusive + exclusive_lost + shared + shared_lost + others}
        print(f"nvidia-smi compute processes: {len(procs)}")
        for line in procs:
            pid = line.split(",")[0].strip()
            stat = pathlib.Path(f"/proc/{pid}/stat")
            try:
                pgid = int(stat.read_text().rsplit(")", 1)[1].split()[2])  # field 5, pgrp
            except (OSError, ValueError, IndexError):
                pgid = None
            owner = groups.get(pgid)
            if owner is None or job_class(owner) != "shared":
                unattributed += 1  # only a shared job's GPU work leaves the host to shared jobs
            print(f"  {line}  " + (f"[job {owner['name']}]" if owner else "[not a spark-job job]"))
    held = len(shared) + len(shared_lost)
    if exclusive or exclusive_lost or exclusive_waiting or unattributed:
        verdict, code = "busy", BUSY_EXIT
    elif held or shared_waiting:
        verdict, code = "shared", SHARED_EXIT
    else:
        verdict, code = "free", 0
    print(f"{socket.gethostname()}: {verdict} (exclusive: {len(exclusive) + len(exclusive_lost)} running, "
          f"{len(exclusive_waiting)} waiting; shared: {held} of {slots} running, "
          f"{len(shared_waiting)} waiting; {len(procs or [])} GPU compute process(es))")
    return code


# ---------------------------------------------------------------- main

def main() -> int:
    parser = argparse.ArgumentParser(prog="spark-job", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="action", required=True,
                                metavar="{start,status,wait,tail,kill,gc,busy}")
    p = sub.add_parser("start", help="run CMD (or a queue of steps) detached under a supervisor")
    p.add_argument("--name", required=True)
    p.add_argument("--timeout", type=float, help="the whole job's limit, seconds, counted from admission")
    p.add_argument("--gpu", action="store_true",
                   help="an exclusive job (measurements, gate runs, timing and model tests): it runs "
                        "alone, waiting for every --gpu and --shared job here to end (see `busy`)")
    p.add_argument("--shared", action="store_true",
                   help="a shared job (builds, other functional tests): up to $LLMP_JOBS_SHARED "
                        f"(default {SHARED_DEFAULT}) run at once, never beside or ahead of a --gpu job")
    p.add_argument("--no-wait", action="store_true",
                   help="with --gpu or --shared: refuse at once if the job cannot start now, "
                        "instead of waiting")
    p.add_argument("-C", "--cwd", help="run in this directory (default: the current one)")
    p.add_argument("--grace", type=float, default=10.0, help="seconds between SIGTERM and SIGKILL")
    p.add_argument("--steps", help="a file of shell commands, one per line, run in order")
    p.add_argument("--step-timeout", type=float, help="each step's limit, seconds (the queue moves on)")
    p.add_argument("--stop-on-fail", action="store_true", help="skip the remaining steps after a failure")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p.set_defaults(func=cmd_start)
    p = sub.add_parser("_supervise")
    p.add_argument("job_dir")
    p.set_defaults(func=cmd_supervise)
    p = sub.add_parser("status", help="one job's state, or every job's")
    p.add_argument("name", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--stale-hours", type=float, default=24.0, help="mark jobs that ended longer ago")
    p.set_defaults(func=cmd_status)
    p = sub.add_parser("wait", help="block until the job ends; exit 0 only for success")
    p.add_argument("name")
    p.add_argument("--timeout", type=float, help="give up after this many seconds (exit 3)")
    p.add_argument("-n", "--lines", type=int, default=40, help="log lines shown on failure")
    p.set_defaults(func=cmd_wait)
    p = sub.add_parser("tail", help="the job's log")
    p.add_argument("name")
    p.add_argument("-n", "--lines", type=int, default=40)
    p.add_argument("-f", "--follow", action="store_true", help="follow until the job ends")
    p.set_defaults(func=cmd_tail)
    p = sub.add_parser("kill", help="stop the job's process group and record it as killed")
    p.add_argument("name")
    p.set_defaults(func=cmd_kill)
    p = sub.add_parser("gc", help="remove finished jobs that ended long ago")
    p.add_argument("--older-than", type=float, default=24.0, metavar="HOURS")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_gc)
    p = sub.add_parser("busy", help="which --gpu and --shared jobs run or wait here, and the GPU's compute "
                                    "processes; exit 0 free, 1 busy (an exclusive job or unattributed GPU "
                                    "work), 3 only shared jobs")
    p.set_defaults(func=cmd_busy)
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
