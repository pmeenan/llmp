diff --git a/ggml/src/ggml-cuda/set-rows.cu b/ggml/src/ggml-cuda/set-rows.cu
--- a/ggml/src/ggml-cuda/set-rows.cu
+++ b/ggml/src/ggml-cuda/set-rows.cu
@@ -373,11 +373,25 @@
 }
 
 
+// BF16 rows are copied without widening or changing their stored bits.
+template<typename idx_t>
+static void set_rows_bf16_cuda(ggml_backend_cuda_context & ctx, const ggml_tensor * src0,
+                               const ggml_tensor * src1, ggml_tensor * dst) {
+    const nv_bfloat16 * src0_d = (const nv_bfloat16 *)src0->data;
+    const idx_t * src1_d = (const idx_t *)src1->data;
+    GGML_TENSOR_BINARY_OP_LOCALS
+    set_rows_cuda(
+        src0_d, src1_d, (nv_bfloat16 *)dst->data,
+        ne00, ne01, ne02, ne03, ne10, ne11, ne12, ne13,
+        nb01, nb02, nb03, nb10, nb11, nb12, nb1, nb2, nb3, ctx.stream());
+}
+
 void ggml_cuda_op_set_rows(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const ggml_tensor * src0 = dst->src[0];
     const ggml_tensor * src1 = dst->src[1];
 
-    GGML_ASSERT(src0->type == GGML_TYPE_F32 || (src0->type == GGML_TYPE_F16 && dst->type == GGML_TYPE_F16));
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 || (src0->type == GGML_TYPE_F16 && dst->type == GGML_TYPE_F16) ||
+                (src0->type == GGML_TYPE_BF16 && dst->type == GGML_TYPE_BF16));
     GGML_ASSERT(src1->type == GGML_TYPE_I64 || src1->type == GGML_TYPE_I32);
 
     if (src0->type == GGML_TYPE_F32) {
@@ -392,6 +406,12 @@
         } else {
             set_rows_cuda<half, int32_t>(ctx, src0, src1, dst);
         }
+    } else if (src0->type == GGML_TYPE_BF16) {
+        if (src1->type == GGML_TYPE_I64) {
+            set_rows_bf16_cuda<int64_t>(ctx, src0, src1, dst);
+        } else {
+            set_rows_bf16_cuda<int32_t>(ctx, src0, src1, dst);
+        }
     } else {
         GGML_ABORT("unsupported type %s", ggml_type_name(src0->type));
     }
