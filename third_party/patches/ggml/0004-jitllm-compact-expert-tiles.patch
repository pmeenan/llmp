+#endif
 };
 
+#ifdef GGML_JITLLM
+// The list is bounded without reading expert counts back to the host:
+// sum_e ceil(rows_e/J) <= ceil(sum_e rows_e/J) + nexperts.
+// A fixed-capacity list keeps the launch capturable; unused entries are dummies.
+template <int J>
+static __global__ void mmq_expert_tiles(const int32_t * bounds, int2 * tiles,
+        const int nexperts, const int capacity) {
+    extern __shared__ int prefix[];
+    for (int e = threadIdx.x; e < nexperts; e += blockDim.x) {
+        prefix[e + 1] = (bounds[e + 1] - bounds[e] + J - 1) / J;
+    }
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        prefix[0] = 0;
+        for (int e = 0; e < nexperts; ++e) {
+            prefix[e + 1] += prefix[e];
+        }
+    }
+    __syncthreads();
+    for (int t = threadIdx.x; t < capacity; t += blockDim.x) {
+        if (t >= prefix[nexperts]) {
+            tiles[t] = make_int2(-1, -1);
+            continue;
+        }
+        int lo = 0;
+        int hi = nexperts;
+        while (lo + 1 < hi) {
+            const int mid = (lo + hi) / 2;
+            if (prefix[mid] <= t) {
+                lo = mid;
+            } else {
+                hi = mid;
+            }
+        }
+        tiles[t] = make_int2(lo, t - prefix[lo]);
+    }
+}
+
+static int64_t mmq_compact_expert_capacity(const ggml_type type, const int64_t rows,
+        const int64_t tokens, const int64_t assignments, const int64_t experts, const int J) {
+    if (type == GGML_TYPE_MXFP4 || type == GGML_TYPE_NVFP4 || tokens < 256 || rows < 128 ||
+            experts < 64 || experts > 1024) {
+        return 0;
+    }
+    const int64_t capacity = (assignments + J - 1) / J + experts;
+    return capacity <= 65535 ? capacity : 0;
+}
+
+static bool mmq_use_compact_experts(const mmq_args & args, const int J) {
+    return args.compact_experts && args.ids_dst && args.expert_bounds &&
+        args.nchannels_x == args.nchannels_y && args.nsamples_x == 1 && args.nsamples_y == 1 &&
+        mmq_compact_expert_capacity(args.type_x, args.nrows_x, args.ncols_max,
+            args.ncols_dst, args.nchannels_x, J) != 0;
+}
+#endif
+
 static size_t mmq_get_nbytes_shared(const ggml_cuda_mmq_config & config, const int cc) {
     const size_t nbs_ids = config.J*sizeof(int);
     const size_t nbs_x = ggml_cuda_mmq_get_nbytes_shared_x(config, cc);
@@ -1426,6 +1491,28 @@ static void launch_mul_mat_q(ggml_backend_cuda_context & ctx, const mmq_args & a
     const uint3 channel_ratio_fd   = init_fastdiv_values(channel_ratio);
     const uint3 sample_ratio_fd    = init_fastdiv_values(sample_ratio);
 
+#ifdef GGML_JITLLM
+    if constexpr (type != GGML_TYPE_MXFP4 && type != GGML_TYPE_NVFP4) {
+        if (GGML_CUDA_CC_IS_NVIDIA(cc) && mmq_use_compact_experts(args, config.J)) {
+            CUDA_SET_SHARED_MEMORY_LIMIT((mul_mat_q<type, J, false, true>), nbytes_shared);
+            CUDA_SET_SHARED_MEMORY_LIMIT((mul_mat_q<type, J,  true, true>), nbytes_shared);
+            const int capacity = mmq_compact_expert_capacity(type, args.nrows_x,
+                args.ncols_max, args.ncols_dst, args.nchannels_x, config.J);
+            ggml_cuda_pool_alloc<int2> tiles(ctx.pool(id), capacity);
+            mmq_expert_tiles<J><<<1, 256, (args.nchannels_x + 1)*sizeof(int), stream>>>
+                (args.expert_bounds, tiles.ptr, args.nchannels_x, capacity);
+            const dim3 grid(nty, capacity, 1);
+            mul_mat_q<type, J, fallback, true><<<grid, block_dims, nbytes_shared, stream>>>
+                (args.x, args.y, args.ids_dst, args.expert_bounds, args.dst, nullptr, args.y_scale,
+                 blocks_per_ne00_fd, args.nrows_x, args.ncols_dst, args.stride_row_x, args.ncols_y, args.nrows_dst,
+                 channel_ratio_fd, nchannels_y_fd, args.stride_channel_x, args.stride_channel_y, args.stride_channel_dst,
+                 sample_ratio_fd, nsamples_y_fd, args.stride_sample_x, args.stride_sample_y, args.stride_sample_dst,
+                 ntx_fd, tiles.ptr);
+            return;
+        }
+    }
+#endif
