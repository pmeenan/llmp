+int llmp_q2_K_raw_d2r_launch(const void *weights, uint64_t weight_bytes,
+                                uint64_t row_stride, uint64_t expert_stride,
+                                const void *q8, const int32_t *ids_dst,
+                                const int32_t *bounds, float *output,
+                                int M, int K, int64_t assignments, int E,
+                                void *scratch, size_t scratch_bytes, cudaStream_t stream) {
+    const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
+    if (!ds4_mmq_q2_K_moe_d2r_available(cc)) return 1;
+    // Bound the original 16-bit worklist column tile encoding, keep the
+    // expert's sign bit clear for its signed decode, and bound all raw
+    // address arithmetic including padded expert and row strides.
+    if (!weights || !q8 || !ids_dst || !bounds || !output || !scratch ||
+        M <= 0 || (M & 1) != 0 || K <= 0 || K % 256 != 0 ||
+        E <= 0 || E > 32768 || assignments <= 0 || assignments > 65535ll * kNTile ||
+        (reinterpret_cast<uintptr_t>(weights) & 3u) != 0 ||
+        row_stride == 0 || row_stride > UINT32_MAX || (row_stride & 3u) != 0 ||
+        (expert_stride & 3u) != 0) return -1;
+    const uint64_t row_bytes = static_cast<uint64_t>(K / 256) * 84ull;
+    if (row_stride < row_bytes || static_cast<uint64_t>(M) > UINT64_MAX / row_stride ||
+        expert_stride < static_cast<uint64_t>(M) * row_stride ||
+        static_cast<uint64_t>(E) > UINT64_MAX / expert_stride) return -1;
+    const uint64_t accessed = static_cast<uint64_t>(E - 1) * expert_stride +
+        static_cast<uint64_t>(M - 1) * row_stride + row_bytes;
+    if (weight_bytes < accessed) return -1;
+    const int64_t capacity64 = d2r_work_capacity(assignments, E);
+    if (capacity64 <= 0 || capacity64 > 65535) return -1;
+    const size_t needed = static_cast<size_t>(capacity64) * sizeof(int) + sizeof(int);
+    if (scratch_bytes < needed) return -1;
+    auto *work = static_cast<int *>(scratch);
+    int *count = work + capacity64;
+    d2r_build_worklist_kernel<kNTile><<<1, kThreads, 0, stream>>>(bounds, work, count, E);
+    if (cudaGetLastError() != cudaSuccess) return -2;
+    const dim3 grid(static_cast<unsigned>((static_cast<uint64_t>(M) + kMTile - 1) / kMTile),
+                    static_cast<unsigned>(capacity64), 1);
+    down_q2k_d2r_kernel<64, kNTile, true><<<grid, dim3(32, kWarps, 1), 0, stream>>>(
+        weights, static_cast<const block_q8_1_mmq *>(q8), ids_dst, bounds, work, count,
+        output, M, K, static_cast<int>(assignments), E, row_stride, expert_stride);
+    if (cudaGetLastError() != cudaSuccess) return -3;
+    return 0;
+}
