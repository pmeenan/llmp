+template <bool FullTile, int Iter = 0>
+__device__ __forceinline__ void issue_q2k_native_prefetch_unrolled(
+        Q2KRawWarpStage (&s_raw)[kWarps][kRawStages],
+        const volatile SmemInvariants &s_inv, int raw_stage, int k256_iter) {
+    if constexpr (Iter < kRawCopyTrips) {
+        issue_q2k_native_prefetch_iter<FullTile, Iter>(s_raw, s_inv, raw_stage, k256_iter);
+        issue_q2k_native_prefetch_unrolled<FullTile, Iter + 1>(s_raw, s_inv, raw_stage, k256_iter);
+    }
+}
+
+template <bool FullTile>
+__device__ __forceinline__ void issue_q2k_native_prefetch(
+        Q2KRawWarpStage (&s_raw)[kWarps][kRawStages],
+        const volatile SmemInvariants &s_inv, int raw_stage, int k256_iter) {
+    issue_q2k_native_prefetch_unrolled<FullTile>(s_raw, s_inv, raw_stage, k256_iter);
+    cp_async_commit();
+}
