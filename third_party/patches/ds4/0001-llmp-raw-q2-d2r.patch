+# SPDX-FileCopyrightText: 2026 llmpalooza contributors
+# SPDX-License-Identifier: Apache-2.0
+
+cmake_minimum_required(VERSION 4.4.3)
+project(llmp_ds4 LANGUAGES CXX)
+
+# Only the pinned D2R product unit. No upstream runtime, graph, preparation,
+# repack, dispatcher or build script is compiled/executed. The includes
+# resolve to our independently locked GGML target, not ds4's vendored shim.
+set(product "${CMAKE_CURRENT_SOURCE_DIR}/../cuda/mmq")
+if(CMAKE_CUDA_COMPILER)
+  add_library(llmp_ds4_d2r STATIC "${product}/ds4_mmq_d2r.cu")
+  target_link_libraries(llmp_ds4_d2r PUBLIC llmp_ggml_cuda)
+  target_include_directories(llmp_ds4_d2r PUBLIC "${product}")
+  target_compile_options(llmp_ds4_d2r PRIVATE -O3 -use_fast_math -extended-lambda)
+  set_target_properties(llmp_ds4_d2r PROPERTIES
+    CUDA_STANDARD 17 CUDA_STANDARD_REQUIRED ON
+    CUDA_ARCHITECTURES "121a-real;${LLMP_CUDA_DISCRETE_SASS}")
+else()
+  # Every component target exists in CPU profiles, without CUDA includes
+  # or links reaching llmpalooza's CPU-only model/plan modules.
+  add_library(llmp_ds4_d2r INTERFACE)
+endif()
