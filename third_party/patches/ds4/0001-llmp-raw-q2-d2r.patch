+// Same shared ring as the pinned SoA path; only global addressing changes.
+// w_base is this expert's raw tensor, sc_off_bytes is its raw row stride.
+// Every raw Q2_K block is scales[16], codes[64], half2 dm (84 bytes).
+template <bool FullTile, int Iter>
+__device__ __forceinline__ void issue_q2k_native_prefetch_iter(
+        Q2KRawWarpStage (&s_raw)[kWarps][kRawStages],
+        const volatile SmemInvariants &s_inv, int raw_stage, int k256_iter) {
+    const int warp = d2r_warp();
+    const int lane = d2r_lane();
+    const int warp_row0 = s_inv.cta_row0 + warp * 16;
+    constexpr int half = Iter < 4 ? Iter / 2 : 0;
+    if constexpr (Iter < 4) {
+        const int rem = lane + (Iter % 2) * 32;
+        const int pair = rem / kRawQSWordsPerHalf;
+        const int word = rem % kRawQSWordsPerHalf;
+        const bool valid = k256_iter < s_inv.nb &&
+            (FullTile || q2k_raw_pair_valid(warp_row0, pair, s_inv.M));
+        const uint64_t row = valid ? (uint64_t)(warp_row0 + 2 * pair) : 0;
+        const uint64_t kb = valid ? (uint64_t)k256_iter : 0;
+        const char *src0 = s_inv.w_base + row * s_inv.sc_off_bytes + kb * 84ull;
+        const char *src1 = src0 + s_inv.sc_off_bytes;
+        uint2 *dst = &s_raw[warp][raw_stage].qs[half][pair][word];
+        q2raw_cp_async_4B(&dst->x, src0 + 16 + half * 32 + word * 4, valid);
+        q2raw_cp_async_4B(&dst->y, src1 + 16 + half * 32 + word * 4, valid);
+    } else {
+        if (lane < kRawSCChunks) {
+            const int which_half = lane / kRawPairsPerWarp;
+            const int pair = lane % kRawPairsPerWarp;
+            const bool valid = k256_iter < s_inv.nb &&
+                (FullTile || q2k_raw_pair_valid(warp_row0, pair, s_inv.M));
+            const uint64_t row = valid ? (uint64_t)(warp_row0 + 2 * pair) : 0;
+            const uint64_t kb = valid ? (uint64_t)k256_iter : 0;
+            const char *src0 = s_inv.w_base + row * s_inv.sc_off_bytes + kb * 84ull;
+            const char *src1 = src0 + s_inv.sc_off_bytes;
+            int4 *dst = &s_raw[warp][raw_stage].sc[which_half][pair];
+            q2raw_cp_async_4B(&dst->x, src0 + which_half * 8, valid);
+            q2raw_cp_async_4B(&dst->y, src0 + which_half * 8 + 4, valid);
+            q2raw_cp_async_4B(&dst->z, src1 + which_half * 8, valid);
+            q2raw_cp_async_4B(&dst->w, src1 + which_half * 8 + 4, valid);
+        } else if (lane < kRawSCChunks + kRawDMChunks) {
+            const int pair = lane - kRawSCChunks;
+            const bool valid = k256_iter < s_inv.nb &&
+                (FullTile || q2k_raw_pair_valid(warp_row0, pair, s_inv.M));
+            const uint64_t row = valid ? (uint64_t)(warp_row0 + 2 * pair) : 0;
+            const uint64_t kb = valid ? (uint64_t)k256_iter : 0;
+            const char *src0 = s_inv.w_base + row * s_inv.sc_off_bytes + kb * 84ull;
+            const char *src1 = src0 + s_inv.sc_off_bytes;
+            uint2 *dst = &s_raw[warp][raw_stage].dm[pair];
+            q2raw_cp_async_4B(&dst->x, src0 + 80, valid);
+            q2raw_cp_async_4B(&dst->y, src1 + 80, valid);
+        }
+    }
+}
