# Build directories (CMakePresets.json).
/build/

# Experiment reports and reproduction tools belong in Git; run output does not.
/docs/experiments/**/results/
/docs/experiments/**/raw/
/docs/experiments/**/logs/
/docs/experiments/**/traces/
/docs/experiments/**/*.csv
/docs/experiments/**/*.csv.license
/docs/experiments/**/*.jsonl
/docs/experiments/**/*.jsonl.license
/docs/experiments/**/*.log
/docs/experiments/**/*.log.license
/docs/experiments/**/*.stderr
/docs/experiments/**/*.stderr.license
/docs/experiments/**/__pycache__/

# Python bytecode from tools/ and tests/ (the scripts themselves write none).
/tools/**/__pycache__/
/tests/**/__pycache__/
