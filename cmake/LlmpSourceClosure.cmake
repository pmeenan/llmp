# CMake owns translation-unit and usage-requirement selection. The compiler
# owns include/PCH/preprocessor semantics. This file selects owned build targets
# and installs the provenance launcher; it never scans C++ source text.
# Called at the top-level front door, before project-owned generation. This
# snapshot establishes source membership without feeding unrelated file bytes
# into implementation identity. Ordinary incremental edits remain supported.
function(llmp_identity_source_paths out)
  file(GLOB roots CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${PROJECT_SOURCE_DIR}/*" "${PROJECT_SOURCE_DIR}/.[!.]*")
  set(paths "")
  foreach(path IN LISTS roots)
    get_filename_component(name "${path}" NAME)
    if(name STREQUAL "build" OR name STREQUAL ".git")
      continue()
    endif()
    if(IS_DIRECTORY "${path}")
      file(GLOB_RECURSE children CONFIGURE_DEPENDS LIST_DIRECTORIES FALSE "${path}/*" "${path}/.[!.]*")
      list(APPEND paths ${children})
    else()
      list(APPEND paths "${path}")
    endif()
  endforeach()
  list(FILTER paths EXCLUDE REGEX "/__pycache__/|\\.pyc$")
  list(REMOVE_DUPLICATES paths)
  list(SORT paths)
  set(${out} "${paths}" PARENT_SCOPE)
endfunction()

function(llmp_identity_freeze_sources)
  llmp_identity_source_paths(paths)
  set(snapshot "")
  foreach(path IN LISTS paths)
    file(SHA256 "${path}" hash)
    file(TIMESTAMP "${path}" stamp "%s.%f" UTC)
    list(APPEND snapshot "${path}|${hash}|${stamp}")
  endforeach()
  set_property(GLOBAL PROPERTY LLMP_IDENTITY_OWNED_INPUTS "${paths}")
  set_property(GLOBAL PROPERTY LLMP_IDENTITY_SOURCE_SNAPSHOT "${snapshot}")
  cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL llmp_identity_finish_freeze)
endfunction()

function(llmp_identity_finish_freeze)
  llmp_identity_source_paths(current)
  get_property(original GLOBAL PROPERTY LLMP_IDENTITY_OWNED_INPUTS)
  if(NOT current STREQUAL original)
    message(FATAL_ERROR "Configure changed frozen source membership; generated inputs need a declared recipe outside the authored-source tree")
  endif()
  get_property(snapshot GLOBAL PROPERTY LLMP_IDENTITY_SOURCE_SNAPSHOT)
  foreach(entry IN LISTS snapshot)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 path)
    list(GET parts 1 expected_hash)
    list(GET parts 2 expected_stamp)
    if(NOT EXISTS "${path}")
      message(FATAL_ERROR "Configure removed frozen source ${path}; generated inputs need a declared recipe")
    endif()
    file(SHA256 "${path}" hash)
    file(TIMESTAMP "${path}" stamp "%s.%f" UTC)
    if(NOT hash STREQUAL expected_hash OR NOT stamp STREQUAL expected_stamp)
      message(FATAL_ERROR "Configure mutated frozen source ${path}; generate outside the immutable source tree with a declared recipe")
    endif()
  endforeach()
endfunction()

function(llmp_source_links out target)
  set(result "")
  foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
    get_target_property(links "${target}" "${property}")
    if(NOT links)
      continue()
    endif()
    foreach(link IN LISTS links)
      if(link MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
        set(link "${CMAKE_MATCH_1}")
      endif()
      if(TARGET "${link}")
        list(APPEND result "${link}")
      elseif(link MATCHES "\\$<")
        message(FATAL_ERROR "Compiler identity cannot resolve ${target}'s link ${link}")
      endif()
    endforeach()
  endforeach()
  set(${out} "${result}" PARENT_SCOPE)
endfunction()

function(llmp_identity_quote out value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(llmp_identity_array out)
  set(array "[]")
  set(index 0)
  foreach(value IN LISTS ARGN)
    llmp_identity_quote(quoted "${value}")
    string(JSON array SET "${array}" ${index} "${quoted}")
    math(EXPR index "${index} + 1")
  endforeach()
  set(${out} "${array}" PARENT_SCOPE)
endfunction()

function(llmp_compiler_identity)
  cmake_parse_arguments(ARG "" "OUTPUT;SELECT_TARGET;SELECT_SOURCE;CONSTANT_TARGET" "TARGETS;FILES;EXCLUDED_SOURCES" ${ARGN})
  if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
    message(FATAL_ERROR "Compiler identity supports the pinned single-config Ninja build")
  endif()
  set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Compiler provenance inventory" FORCE)
  cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)
  set(tool "${PROJECT_SOURCE_DIR}/tools/compiler_identity.py")
  set(files ${ARG_FILES} "${tool}")
  set(queue ${ARG_TARGETS})
  set(visited "")
  set(compiled "")
  set(objects "")
  while(queue)
    list(POP_FRONT queue target)
    get_target_property(alias "${target}" ALIASED_TARGET)
    if(alias)
      set(target "${alias}")
    endif()
    if(target IN_LIST visited)
      continue()
    endif()
    list(APPEND visited "${target}")
    llmp_source_links(links "${target}")
    list(APPEND queue ${links})
    get_target_property(directory "${target}" SOURCE_DIR)
    get_target_property(imported "${target}" IMPORTED)
    cmake_path(IS_PREFIX PROJECT_SOURCE_DIR "${directory}" NORMALIZE owned)
    cmake_path(IS_PREFIX LLMP_SOURCES_DIR "${directory}" NORMALIZE prepared)
    if(imported OR NOT owned OR prepared OR target STREQUAL "llmp_ggml_rank_data")
      continue()
    endif()
    set(parent "${directory}")
    while(NOT parent STREQUAL PROJECT_SOURCE_DIR)
      if(EXISTS "${parent}/CMakeLists.txt")
        list(APPEND files "${parent}/CMakeLists.txt")
      endif()
      cmake_path(GET parent PARENT_PATH parent)
    endwhile()
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
      continue()
    endif()
    if(NOT type MATCHES "^(STATIC|OBJECT)_LIBRARY$")
      message(FATAL_ERROR "Compiler identity needs an explicit object contract for ${target}/${type}")
    endif()
    list(APPEND compiled "${target}")
    list(APPEND objects "$<TARGET_OBJECTS:${target}>")
  endwhile()
  # graph_plan is the selected production entry point, not the whole engine.
  list(APPEND compiled "${ARG_SELECT_TARGET}")
  list(APPEND objects "$<TARGET_OBJECTS:${ARG_SELECT_TARGET},SOURCE_FILES:${ARG_SELECT_SOURCE}>")
  get_target_property(directory "${ARG_SELECT_TARGET}" SOURCE_DIR)
  list(APPEND files "${directory}/CMakeLists.txt")
  file(GLOB_RECURSE build_files CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/cmake/*.cmake")
  if(CMAKE_TOOLCHAIN_FILE)
    list(APPEND build_files "${CMAKE_TOOLCHAIN_FILE}")
    get_filename_component(toolchain_directory "${CMAKE_TOOLCHAIN_FILE}" DIRECTORY)
    if(EXISTS "${toolchain_directory}/sdk.cmake")
      list(APPEND build_files "${toolchain_directory}/sdk.cmake")
    endif()
  endif()
  list(REMOVE_DUPLICATES build_files)
  list(APPEND files ${build_files} "${PROJECT_SOURCE_DIR}/CMakeLists.txt"
       "${PROJECT_SOURCE_DIR}/CMakePresets.json" "${PROJECT_SOURCE_DIR}/src/CMakeLists.txt"
       "${PROJECT_SOURCE_DIR}/src/kernels/CMakeLists.txt")
  list(REMOVE_DUPLICATES files)
  list(SORT files)
  list(APPEND compiled "${ARG_CONSTANT_TARGET}")
  list(REMOVE_DUPLICATES compiled)

  get_filename_component(binary "${ARG_OUTPUT}" DIRECTORY)
  set(config "${binary}/compiler_identity.json")
  set(catalog "${binary}/compiler_ownership.json")
  set(manifest "${binary}/compiler_objects.txt")
  set(receipt "${binary}/compiler_identity_receipt.json")
  set(json "{\"schema\":1}")
  get_target_property(constant_binary "${ARG_CONSTANT_TARGET}" BINARY_DIR)
  foreach(pair IN ITEMS "constant_source|${ARG_OUTPUT}" "identity_receipt|${receipt}"
      "constant_compiler|${CMAKE_CXX_COMPILER}"
      "constant_object_prefix|${constant_binary}/CMakeFiles/${ARG_CONSTANT_TARGET}.dir/")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 name)
    list(GET parts 1 value)
    llmp_identity_quote(quoted "${value}")
    string(JSON json SET "${json}" "${name}" "${quoted}")
  endforeach()
  get_property(owned_inputs GLOBAL PROPERTY LLMP_IDENTITY_OWNED_INPUTS)
  if(NOT owned_inputs)
    message(FATAL_ERROR "Compiler identity requires llmp_identity_freeze_sources at the configure front door")
  endif()
  # Membership is validation authority, not a compiler semantic input. Keep
  # the complete catalog separate so unrelated authored files do not change
  # every compile command/config dependency. The digest still depends on it.
  set(ownership "{\"schema\":1}")
  llmp_identity_array(array ${owned_inputs})
  string(JSON ownership SET "${ownership}" owned_inputs "${array}")
  set(declared_generated "")
  foreach(path IN LISTS owned_inputs)
    get_source_file_property(generated "${path}" GENERATED)
    if(generated)
      list(APPEND declared_generated "${path}")
    endif()
  endforeach()
  llmp_identity_array(array ${declared_generated})
  string(JSON ownership SET "${ownership}" declared_generated "${array}")
  llmp_identity_quote(value "${catalog}")
  string(JSON json SET "${json}" ownership_catalog "${value}")
  file(GENERATE OUTPUT "${catalog}" CONTENT "${ownership}\n")
  llmp_identity_quote(value "${CMAKE_MAKE_PROGRAM}")
  string(JSON json SET "${json}" ninja "${value}")
  foreach(pair IN ITEMS "source|${PROJECT_SOURCE_DIR}" "build|${PROJECT_BINARY_DIR}"
                        "sdk|${LLMP_SDK}" "prepared|${LLMP_SOURCES_DIR}")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 name)
    list(GET parts 1 value)
    llmp_identity_quote(value "${value}")
    string(JSON json SET "${json}" "${name}" "${value}")
  endforeach()
  llmp_identity_array(array ${CMAKE_C_COMPILER} ${CMAKE_CXX_COMPILER} ${CMAKE_CUDA_COMPILER})
  string(JSON json SET "${json}" compilers "${array}")
  llmp_identity_array(array ${files})
  string(JSON json SET "${json}" declarations "${array}")
  llmp_identity_array(array ${ARG_EXCLUDED_SOURCES})
  string(JSON json SET "${json}" excluded_sources "${array}")
  set(derived "{}")
  foreach(module IN ITEMS exl3 decode)
    string(TOUPPER "${module}" upper)
    get_property(names GLOBAL PROPERTY "LLMP_${upper}_MODULE_NAMES")
    if(names)
      set(base "${PROJECT_SOURCE_DIR}/src/kernels/${module}")
      string(REPLACE ":" ";" inputs "${names}")
      list(TRANSFORM inputs PREPEND "${base}/")
      set(recipe "{}")
      llmp_identity_quote(value "${module}:${names}")
      string(JSON recipe SET "${recipe}" identity "${value}")
      llmp_identity_array(array ${inputs})
      string(JSON recipe SET "${recipe}" inputs "${array}")
      llmp_identity_array(array "${CMAKE_COMMAND}" "-DBASE=${base}" "-DNAMES=${names}"
                               "-DOUTPUT=@OUTPUT@" "-P" "${base}/module_digest.cmake")
      string(JSON recipe SET "${recipe}" command "${array}")
      string(JSON derived SET "${derived}" "${PROJECT_BINARY_DIR}/src/kernels/${module}/module_digest.cc" "${recipe}")
    endif()
  endforeach()
  if(TARGET llmp_ggml_rank_data)
    set(rank_source "${PROJECT_BINARY_DIR}/src/kernels/ggml/fusion_rank_data.cc")
    set(rank_json "${PROJECT_SOURCE_DIR}/docs/experiments/fusion-ranks/data.json")
    set(rank_generator "${PROJECT_SOURCE_DIR}/tools/fusion_rank_data.py")
    set(recipe "{\"identity\":\"fusion-rank-data-v1\"}")
    llmp_identity_array(array "${rank_json}")
    string(JSON recipe SET "${recipe}" value_inputs "${array}")
    llmp_identity_array(array "${rank_json}" "${rank_generator}")
    string(JSON recipe SET "${recipe}" inputs "${array}")
    llmp_identity_array(array "${LLMP_PYTHON}" "${rank_generator}" "${rank_json}" "@OUTPUT@")
    string(JSON recipe SET "${recipe}" command "${array}")
    string(JSON derived SET "${derived}" "${rank_source}" "${recipe}")
    list(APPEND ARG_EXCLUDED_SOURCES "${rank_source}")
    llmp_identity_array(array ${ARG_EXCLUDED_SOURCES})
    string(JSON json SET "${json}" excluded_sources "${array}")
    list(APPEND compiled llmp_ggml_rank_data)
    list(APPEND objects "$<TARGET_OBJECTS:llmp_ggml_rank_data>")
  endif()
  string(JSON json SET "${json}" derived "${derived}")
  set(identity "{}")
  foreach(variable IN ITEMS LLMP_SDK_IDENTITY LLMP_TARGET_TRIPLE LLMP_PROFILE LLMP_SANITIZE
                            LLMP_LIBSTDCXX_ASSERTIONS CMAKE_BUILD_TYPE CMAKE_VERSION)
    llmp_identity_quote(value "${${variable}}")
    string(JSON identity SET "${identity}" "${variable}" "${value}")
  endforeach()
  # The sole supported generated compile input is the SDK's host wrapper.
  # file(CONFIGURE) above emitted it from these complete recipe inputs; check
  # its actual bytes at launch and record root-independent recipe parameters.
  set(generated "{}")
  if(CMAKE_CUDA_HOST_COMPILER)
    set(recipe "{}")
    file(SHA256 "${CMAKE_CUDA_HOST_COMPILER}" wrapper_hash)
    llmp_identity_quote(value "${wrapper_hash}")
    string(JSON recipe SET "${recipe}" sha256 "${value}")
    llmp_identity_array(value ${build_files})
    string(JSON recipe SET "${recipe}" inputs "${value}")
    string(JSON generated SET "${generated}" "${CMAKE_CUDA_HOST_COMPILER}" "${recipe}")
  endif()
  set(wrapper "{}")
  foreach(variable IN ITEMS LLMP_TARGET_TRIPLE LLMP_TARGET_MARCH LLMP_LINK_FLAGS LLMP_SYSROOT LLMP_PROFILE)
    llmp_identity_quote(value "${${variable}}")
    string(JSON wrapper SET "${wrapper}" "${variable}" "${value}")
  endforeach()
  string(JSON identity SET "${identity}" host_wrapper "${wrapper}")
  get_property(entries GLOBAL PROPERTY LLMP_SOURCES_ENTRIES)
  if(entries)
    string(JSON count LENGTH "${entries}")
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE ${last})
        string(JSON entries REMOVE "${entries}" ${index} source)
      endforeach()
    endif()
    string(JSON identity SET "${identity}" source_receipt "${entries}")
  endif()
  set(recipes "{}")
  foreach(path IN LISTS build_files)
    file(RELATIVE_PATH name "${PROJECT_SOURCE_DIR}" "${path}")
    file(SHA256 "${path}" hash)
    llmp_identity_quote(value "${hash}")
    string(JSON recipes SET "${recipes}" "${name}" "${value}")
  endforeach()
  string(JSON identity SET "${identity}" build_recipes "${recipes}")
  string(JSON json SET "${json}" identity "${identity}")
  string(JSON json SET "${json}" generated "${generated}")
  file(GENERATE OUTPUT "${config}" CONTENT "${json}\n")
  file(SHA256 "${tool}" tool_hash)
  string(SHA256 stamp "${json};${tool_hash}")
  set(launcher "${LLMP_PYTHON};${tool};compile;--config;${config};--stamp;${stamp};--")
  foreach(target IN LISTS compiled)
    foreach(property IN ITEMS C_COMPILER_LAUNCHER CXX_COMPILER_LAUNCHER CUDA_COMPILER_LAUNCHER
                              PRECOMPILE_HEADERS INTERFACE_PRECOMPILE_HEADERS RULE_LAUNCH_COMPILE)
      get_target_property(value "${target}" "${property}")
      if(value)
        message(FATAL_ERROR "Compiler identity needs explicit provenance support for ${target}/${property}: ${value}")
      endif()
    endforeach()
    get_target_property(directory "${target}" SOURCE_DIR)
    get_property(rule DIRECTORY "${directory}" PROPERTY RULE_LAUNCH_COMPILE)
    get_property(global_rule GLOBAL PROPERTY RULE_LAUNCH_COMPILE)
    if(rule OR global_rule)
      message(FATAL_ERROR "Compiler identity cannot compose an arbitrary compile launcher")
    endif()
    get_target_property(scan "${target}" CXX_SCAN_FOR_MODULES)
    if(scan)
      message(FATAL_ERROR "Compiler identity needs a C++ module provenance recipe for ${target}")
    endif()
    set_target_properties("${target}" PROPERTIES EXPORT_COMPILE_COMMANDS ON C_COMPILER_LAUNCHER "${launcher}"
        CXX_COMPILER_LAUNCHER "${launcher}" CUDA_COMPILER_LAUNCHER "${launcher}")
    # Fixed values remove wall-clock/file-mtime dependence even if source
    # pragmas override warning policy. These are explicit compile semantics.
    target_compile_definitions("${target}" PRIVATE
      "__DATE__=\"Jan  1 1970\"" "__TIME__=\"00:00:00\"" "__TIMESTAMP__=\"Thu Jan  1 00:00:00 1970\"")
    target_compile_options("${target}" PRIVATE
      "$<$<COMPILE_LANGUAGE:C,CXX>:--no-default-config;-Werror=date-time;-Wno-builtin-macro-redefined>"
      "$<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=--no-default-config;-Xcompiler=-Werror=date-time;-Xcompiler=-Wno-builtin-macro-redefined>")
    foreach(pair IN ITEMS "${PROJECT_SOURCE_DIR}=llmp/source" "${PROJECT_BINARY_DIR}=llmp/build"
                          "${LLMP_SDK}=llmp/sdk" "${LLMP_SOURCES_DIR}=llmp/prepared")
      target_compile_options("${target}" PRIVATE
        "$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${pair}>"
        "$<$<COMPILE_LANGUAGE:CUDA>:-Xcompiler=-ffile-prefix-map=${pair}>")
    endforeach()
  endforeach()
  file(GENERATE OUTPUT "${manifest}" CONTENT "$<JOIN:${objects},\n>\n")
  # These configure/generate-time products are compiler-launcher inputs, not
  # translation units. Declare their ownership so CMake exposes them in the
  # current File API target inventory. Compile depfiles retain the semantic
  # config; the ownership catalog belongs to the digest dependency edge. The
  # generic source audit still rejects undeclared build-tree files.
  set(configured_inputs "${config}" "${catalog}" "${manifest}")
  if(CMAKE_CUDA_HOST_COMPILER)
    list(APPEND configured_inputs "${CMAKE_CUDA_HOST_COMPILER}")
  endif()
  set_source_files_properties(${configured_inputs} TARGET_DIRECTORY "${ARG_CONSTANT_TARGET}"
    PROPERTIES GENERATED TRUE HEADER_FILE_ONLY TRUE)
  target_sources("${ARG_CONSTANT_TARGET}" PRIVATE ${configured_inputs})
  add_custom_command(OUTPUT "${ARG_OUTPUT}" "${receipt}"
    COMMAND "${LLMP_PYTHON}" "${tool}" digest --config "${config}"
            --objects "${manifest}" --output "${ARG_OUTPUT}" --receipt "${receipt}"
    DEPENDS ${objects} ${files} "${config}" "${catalog}" "${manifest}" "${PROJECT_BINARY_DIR}/compile_commands.json"
    COMMENT "Checking compiler-owned implementation provenance"
    VERBATIM)
  # The public archive is declared in a child directory. An explicit target
  # carries this custom command across CMake directory ownership boundaries.
  add_custom_target(llmp_compiler_identity_ready DEPENDS "${ARG_OUTPUT}" "${receipt}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${tool}")
  set_property(GLOBAL PROPERTY LLMP_GGML_IDENTITY_CONFIG "${config}")
  set_property(GLOBAL PROPERTY LLMP_GGML_IDENTITY_OBJECTS "${manifest}")
  set_property(GLOBAL PROPERTY LLMP_GGML_IDENTITY_RECEIPT "${receipt}")
endfunction()
